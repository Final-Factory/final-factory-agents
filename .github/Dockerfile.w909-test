FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git && rm -rf /var/lib/apt/lists/*
ARG NODE_VERSION=24.21.0
ARG GITLEAKS_VERSION=8.30.1
ARG PLAYWRIGHT_VERSION=1.63.0
RUN set -eux; \
    apt-get update; apt-get install -y --no-install-recommends xz-utils jq; \
    cd /tmp; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz"; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt"; \
    grep " node-v${NODE_VERSION}-linux-x64.tar.xz\$" SHASUMS256.txt | sha256sum -c -; \
    tar -xJf "node-v${NODE_VERSION}-linux-x64.tar.xz" -C /usr/local --strip-components=1 --no-same-owner; \
    rm -f node-v*.tar.xz SHASUMS256.txt; \
    node --version; npm --version; \
    base="https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}"; \
    file="gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"; \
    curl -fsSLO "${base}/${file}"; curl -fsSLO "${base}/gitleaks_${GITLEAKS_VERSION}_checksums.txt"; \
    grep " ${file}\$" "gitleaks_${GITLEAKS_VERSION}_checksums.txt" | sha256sum -c -; \
    tar -xzf "${file}" -C /usr/local/bin gitleaks; \
    rm -f gitleaks_*; gitleaks version; \
    mkdir /tmp/pw && cd /tmp/pw && npm init -y >/dev/null && npm install --no-audit --no-fund "playwright-core@${PLAYWRIGHT_VERSION}"; \
    node node_modules/playwright-core/cli.js install-deps chromium webkit; \
    cd /; rm -rf /tmp/pw /var/lib/apt/lists/*; npm cache clean --force; \
    echo "node $(node --version), gitleaks $(gitleaks version), playwright libs for ${PLAYWRIGHT_VERSION}"
RUN node --version && npm --version && gitleaks version && jq --version && df -h / | tail -1
