#!/usr/bin/env bash
#
# ffbox — hand a prompt to Claude, running one-shot inside a disposable Final Factory container.
#
# A plain prompt is an INGRESS: it is submitted to ffwatch as a turn, the same as a Discord
# message, and ffwatch launches this script again in executor mode to do the work. One pipeline,
# several front doors — so a shell run gets the same ceilings, kill switch, transcript index and
# web page as everything else. --direct opts out; --task/--job-file IS executor mode.
#
#   ffbox "make the belt merger respect item priority"
#   ffbox --prompt-file ./task.md
#   ffbox --task ffbox/discord-task.sh --job-file job.json --run-id d7t2-1a2b   (ffwatch)
#
# Each run gets its own ZFS clone of the golden checkout, bind-mounted into a container built on
# the same Unity image CI uses. The clone is instant and costs ~0 bytes no matter how large the
# checkout is, and it inherits golden's warm Library/, so Unity does not re-import from cold.
# When the run ends, the changes are harvested as a patch and the clone is destroyed.
set -euo pipefail

# --- configuration (override via environment) ------------------------------------------------
# WHICH DAEMON, SET HERE RATHER THAN INHERITED. ffbox runs on the shared rootless daemon that
# ffbox-container owns, alongside the CI runners. Leaving this to the environment does not work:
# `docker` falls back to the CURRENT CONTEXT when DOCKER_HOST is unset, and this account's context
# is still `rootless` -> unix:///run/user/1015/docker.sock. The profile.d line only reaches a login
# shell, so anything non-interactive — a systemd unit, ffwatch, a script — silently used the old
# daemon. Measured on 2026-08-29: the run reached the old daemon, where the clone's owning uid
# 1020 is not in the map, and the container refused with "owned by a uid this daemon cannot map".
DOCKER_HOST=${DOCKER_HOST:-unix://${FFBOX_DOCKER_SOCK:-/run/ffbox-container/docker.sock}}
export DOCKER_HOST

IMAGE=${FFBOX_IMAGE:-ffbox:latest}
# THE WORKSPACE COMES FROM CI'S CACHE, NOT FROM GOLDEN. A run used to be a ZFS clone of
# /opt/FinalFactory, which meant golden had to exist, be current, and carry a warm Library that
# 04-warmLibrary.sh built for it. All three are gone: the tar CI already writes is a whole
# workspace including that Library, and the local git mirror supplies the commits since.
#
# /opt/FinalFactory stays on this box as a place to edit Final Factory by hand. Nothing here
# reads it any more.
# Named only so the "apply with" hint at the end can point somewhere useful. ffbox does not read
# this path any more; it stays on the box as a place to edit Final Factory by hand.
DEV_CHECKOUT=${FFBOX_DEV_CHECKOUT:-/opt/FinalFactory}
CACHE_DIR=${FFBOX_CACHE_DIR:-/opt/ffcache}
CACHE_ENTRIES=${FFBOX_CACHE_ENTRIES:-$CACHE_DIR/entries}
MIRROR_REPO_PATH=${FFBOX_MIRROR_REPO:-$CACHE_DIR/mirror/FinalFactory.git}
UNITY_SCOPE=${FFBOX_UNITY_SCOPE:-}
# A RAMDRIVE, LIKE THE CI RUNNERS USE, and the difference is not marginal. The same 22 GB entry
# extracts in 35s here against 193s on the ZFS mirror -- 89,664 files, and it is the WRITES that
# cost, not the reads: the tar itself comes off disk in 12s at 1.7 GB/s. CI has always had this
# (--tmpfs on the job container); the agent path was the one still writing a whole workspace to
# spinning disk on every run.
#
# /dev/shm because it is already a 378 GB tmpfs and needs no provisioning or root. Checked before
# relying on it: mounted rw,nosuid,nodev with NO noexec, and execution works through the bind
# mount into the container.
#
# BOUNDED PER RUN WHERE IT CAN BE. /dev/shm is not unlimited -- it is the kernel default of half
# of RAM, 378 GB here -- but that is a bound on ALL of it at once, not on one run, so a single
# runaway workspace could still take memory from CI and everything else.
#
# CI does not have that problem because Docker creates its workspace with size=41943040k and
# Docker has the privilege to. ffbox cannot: mount refuses an unprivileged caller. So this tries a
# per-run tmpfs first and falls back to a plain directory on /dev/shm, where the free-space check
# below is all there is. See docs/ffbox-workspace.md for the one sudoers line that enables it.

# ONE SETTING FOR BOTH SIDES. The CI runners size their job ramdrive from workspace_size, and this
# is the same number for an agent run -- there is no reason for a box to hold two answers to "how
# big may a workspace get", and two would drift.
#
#   FFBOX_WORKSPACE_SIZE in the environment   overrides everything
#   workspace_size in ~/.config/ffbox/config.json   the shared setting, used by both
#   40g                                       the built-in default
#
# The runners keep their own githubrunners/config.json override for the case where CI genuinely
# wants a different ceiling from the agent; absent that, it reads this same value.
FFBOX_CONFIG_JSON=${FFBOX_CONFIG_JSON:-${FFBOX_CONFIG_DIR:-$HOME/.config/ffbox}/config.json}
# ONE VALUE READ FROM THE "container" SECTION, which is where settings that apply to a container
# whichever lane started it live. The agent lane and the CI lane hold the same kind of workspace on
# the same daemon, so a box wants one answer to "how big may one get" rather than two that drift
# apart -- ffbox/runners/lib/config.sh reads the same section for the same key.
_ffbox_cfg() {
    [ -r "$FFBOX_CONFIG_JSON" ] || return 0
    python3 -c '
import json, sys
try:
    v = (json.load(open(sys.argv[1])).get("container") or {}).get(sys.argv[2])
except Exception:
    sys.exit(0)
if v is not None and not isinstance(v, (dict, list)):
    print(v)
' "$FFBOX_CONFIG_JSON" "$1" 2>/dev/null
}
WORKSPACE_SIZE=${FFBOX_WORKSPACE_SIZE:-$(_ffbox_cfg workspace_size)}
[ -n "$WORKSPACE_SIZE" ] || WORKSPACE_SIZE=40g
# THE SAME RESOURCE LIMITS THE CI LANE HAS, from the same section, because the two containers are
# the same size of thing on the same daemon. Until 2026-09-01 a CI job ran under --memory and
# --pids-limit and an agent run ran under neither: an agent container was bounded only by the box,
# so one that leaked took the machine down with it rather than dying on its own.
#
# memory is a ceiling, not an allocation -- the workspace tmpfs plus about 32 GB for the editor --
# and the tmpfs counts against it, which is the point: a run that fills its ramdrive hits its own
# limit instead of the host's.
MEMORY=${FFBOX_MEMORY:-$(_ffbox_cfg memory)}
[ -n "$MEMORY" ] || MEMORY=72g
PIDS_LIMIT=${FFBOX_PIDS_LIMIT:-$(_ffbox_cfg pids_limit)}
[ -n "$PIDS_LIMIT" ] || PIDS_LIMIT=4096

# THE CAPABILITIES, DROPPED TO WHAT THIS LANE ACTUALLY USES. Docker hands a container root about
# fourteen of root's forty-odd separate powers by default -- module loading, raw sockets, ptrace,
# mount, changing the clock -- and this lane needs five of them. The rest are container-escape
# primitives that are simply absent rather than merely unused.
#
# NOT CI'S LIST, and this is the whole reason the agent lane could not just copy slot.sh. A CI job
# stays root from start to finish (RUNNER_ALLOW_RUNASROOT=1; the container is the boundary, not
# the uid), so three capabilities do it. This lane DROPS PRIVILEGE: entrypoint.sh creates a user
# and hands the run to it with setpriv, and changing uid needs CAP_SETUID and CAP_SETGID even
# when you are already root. Measured on 2026-09-01 against the real image -- with CI's three,
# `setpriv --reuid` fails with "setresuid failed: Operation not permitted", and the run dies
# before it starts.
#
#   CHOWN         restore-workspace.sh hands the extracted tree to the run's uid
#   DAC_OVERRIDE  and writes over whatever modes the archive carried
#   FOWNER        chmod/utime on files the archive says belong to somebody else
#   SETUID SETGID the privilege drop itself
#
# NO_NEW_PRIVS on top: once set, nothing in the tree can gain privilege through execve, so a
# setuid binary found later buys nothing. It does not interfere with the drop above, which gives
# privilege up rather than taking it.
CAP_ADD=${FFBOX_CAP_ADD:-CHOWN,DAC_OVERRIDE,FOWNER,SETUID,SETGID}
CAP_ADD_ARGS=()
if [ -n "$CAP_ADD" ]; then
    _oldifs=$IFS; IFS=,
    for _cap in $CAP_ADD; do
        [ -n "$_cap" ] && CAP_ADD_ARGS+=(--cap-add "$_cap")
    done
    IFS=$_oldifs; unset _oldifs _cap
fi
SECRETS=${FFBOX_SECRETS:-$HOME/.config/ffbox/secrets.env}
RESULTS=${FFBOX_RESULTS:-$HOME/ffbox-runs}

# The run's network. ffbox-net is a Docker --internal bridge: no default route, so no internet, no
# LAN, and no reaching this host either — under the rootless daemon the bridge lives inside the
# rootlesskit network namespace, so there is no path to the host to begin with and no firewall
# rule is involved. The single thing on it is the egress proxy at FFBOX_DNS, which resolves and connects
# only the names in ffbox/egress/allowlist.txt. Anything else the container tries is refused at
# the SNI and logged. See docs/docker-security-model.md.
#
# `--network bridge` opts out and restores the old unrestricted egress. That is a real choice an
# operator can make; it is not one an agent inside the container can make.
#
# UNFILTERED INCLUDES THIS HOST. Measured 2026-08-25: a container on the default bridge reached
# this machine's LAN address on port 22, under both daemons. Rootless disables the host
# LOOPBACK, not the host's own IP. So `--network bridge` is not "the fence minus DNS filtering",
# it is no fence.
#
# THE DEFAULT BELOW IS NOT WHAT PRODUCTION RUNS ON, and that is worth knowing before reading it
# as policy. Since 2026-09-02 the network is a PER-POOL setting: config.json says
# pools.<class>.network, which is "limited" or "full" rather than a docker name, and ffwatch
# resolves that one word to a network and passes --network explicitly on every container it
# creates -- ffbox-net for ffagent's "limited", and `bridge` for ffdev's "full", which is
# deliberately unfenced so a dev turn can search the web and fetch what it needs.
#
# THIS FILE TAKES THE DOCKER NAME AND NOT THE POLICY WORD, so exactly one place knows that
# "limited" means ffbox-net and it is the one holding the config file. The default here is what
# a hand-run and `--direct` get, and it stays the fenced one because the safe answer is the one
# you should have to opt out of. To hand-run an ffdev-shaped container, say so:
#     ffbox --agent-class ffdev --network bridge ...
NETWORK=${FFBOX_NETWORK:-ffbox-net}
DNS=${FFBOX_DNS:-10.80.0.2}
EGRESS_NAME=${FFBOX_EGRESS_NAME:-ffbox-egress}

KEEP=0
OUTPUT_FORMAT=text
PROMPT=
DIRECT=0
PROMPT_FILE=
REF=
BRANCH=
BRANCH_PREFIX=
BASE_REFS=
TASK=
JOB_FILE=
RUN_ID_OVERRIDE=
# WHICH KIND OF AGENT CONTAINER THIS IS. It goes on as a label and does nothing else here: both
# classes run the same image, the same task and the same limits, and what differs is the config
# section ffwatch read before it called us and the pool the container is staged into.
#
# THE NETWORK IS PART OF THAT POOL'S CONFIG SECTION and reaches us as --network, NOT derived
# from this name. One place decides, and it is ffwatch reading pools.<class>.network out of
# config.json; this file would be a second opinion that could disagree with it, which is how an
# ffdev container ends up fenced and an operator ends up reading the wrong file to find out why.
# The label is what lets ffwatch count and claim the two pools apart afterwards.
#
# MIRRORS AGENT_CLASSES IN ffwatch.py, which is the original -- this is shell and cannot import
# it. ffweb.py carries the third copy for the same reason.
AGENT_CLASS=ffagent
AGENT_CLASSES="ffagent ffdev"
MOUNTS=()
# --- the pool ------------------------------------------------------------------------------
# A staged container fills its workspace before any request exists and then waits, so that a
# request which finds one starts the agent in about a second rather than in forty. Two modes:
#
#   --stage-pool ID   create one and return as soon as it is up. No job, no clocks, no prompt.
#   --dispatch ID     give an already-staged container this run's job, and from there behave
#                     exactly as a cold run does -- same clocks, same harvest, same output.
#
# Both take the id of a directory under POOL_DIR that the caller has created; ffwatch's keeper
# owns that lifecycle. design/ffbox_idle_agents_design.txt.
STAGE_POOL=
DISPATCH=
POOL_DIR=${FFBOX_POOL_DIR:-$HOME/ffbox-state/pool}
POOL_TASK=${FFBOX_POOL_TASK:-}
IDLE_TTL=${FFBOX_IDLE_TTL_SECS:-14400}
# Golden is brought to origin before every clone (see "golden" below). This is the escape hatch
# for the two cases where that is wrong: reproducing a bug against exactly the code golden is
# already on, and running when origin is unreachable and you would rather have a stale run than
# no run.
SKIP_FETCH=${FFBOX_SKIP_FETCH:-0}

# The three clocks of the Discord design, section 8. They are ENFORCED only when this run is a
# task run (or when one of the flags is given explicitly): a plain interactive one-shot was
# always unbounded and quietly acquiring a one-hour ceiling would be a surprise.
# THE AGENT CLOCK, and the number a person is actually waiting on. Thirty minutes since
# 2026-08-31, raised together with the three repairs that made it mean anything: until then this
# ceiling stopped the container and not the agent, threw the run's work away, and told the caller
# that something had broken. design/ffbox_idle_agents_design.txt section 8. ffwatch passes its own
# value; this is what `ffbox --direct` and a hand-run task get.
AGENT_TIMEOUT=1800       # agent working time, measured from the task's own start marker
WARMUP_TIMEOUT=3600      # clone, container start, Unity activation, Library delta
# Harness-owned verification (design section 14) is a fourth phase with a fourth marker. Without
# its own ceiling it would burn the AGENT clock, and a fix lane whose agent finished in fourteen
# minutes would then be killed mid-test-run and recorded as a hung agent — which is exactly the
# conflation the separate clocks exist to prevent.
VERIFY_TIMEOUT=1800
KILL_GRACE=10            # after SIGTERM is ignored, force
CLOCKS=0

usage() {
    sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'
    cat <<'EOF'

Options:
  --prompt-file FILE   Read the prompt from FILE instead of the command line.
  --direct             Do not route the prompt through ffwatch; run right here.
                       Skips the database, the ceilings and the web page. For bootstrapping a
                       machine and for debugging the container itself.
  --keep               Kept for callers that still pass it; there is nothing left to keep. The
                       workspace is a ramdrive inside the container and the kernel frees it when
                       the run ends. The run's output is under <results>/<run id> regardless.
  --no-fetch           Use the cache entry as it stands instead of fetching the tip from the mirror.
                       Also FFBOX_SKIP_FETCH=1. Without this the run fails rather than
                       silently reasoning against a checkout of unknown age.
  --json               Emit Claude's stream-json output instead of plain text.
  --image NAME         Container image to run (default: ffbox:latest).
  --network NAME       Docker network for the run (default: ffbox-net, the filtered one). Use
                       "bridge" for unrestricted egress — it hands whatever runs in there the
                       whole internet and this machine's LAN. A DOCKER NAME, not the policy word
                       the config file uses: ffwatch always passes this explicitly, resolved from
                       pools.<class>.network in config.json, where ffagent says "limited"
                       (ffbox-net, fenced) and ffdev says "full" (bridge). The default here is
                       only what a hand-run gets.
  --ref REF            Check the workspace out at REF after restoring (a branch, tag or sha;
                       "develop" resolves to origin/develop when no local branch matches).
                       The resolved sha is written to <results>/base_sha.txt.
  --branch NAME        Create NAME at the checked-out commit before the container starts, and
                       harvest the run's work as a git bundle on it (<results>/work.bundle)
                       alongside the patch. Creating it is a ref move, so nothing churns under
                       the warm Library/. No changed files means no commit, no bundle and no
                       branch left behind.
  --base-refs "A B"    Branches the run's work may be based on, most-preferred first (the
                       harness passes "develop master"). At harvest the published range starts
                       at whichever of them the work actually descends from, so an agent that
                       branched off origin/master is bundled against master rather than refused
                       for not descending from the ref the run was checked out at. The name is
                       written to <results>/publish_base.txt, which is what the pull request
                       ends up targeting. Empty means the checked-out commit is the only base.
  --branch-prefix P    Let the agent name the published branch. When the run ends on a branch
                       it made itself, the bundle is harvested as P<that name>-<run id> instead
                       of NAME, so a reviewer reads "ffbox/belt-merger-priority-<id>" rather
                       than a run id. Without this the published name is always NAME. Either
                       way a run that ends on develop, master or main (FFBOX_PROTECTED_BRANCHES)
                       is refused and publishes nothing.
  --task PATH          Container task to run instead of the default one-shot. A host path is
                       mounted read-only at /ffbox/task.sh; anything else is taken as a path
                       already inside the image. Sets FFBOX_ENTRY.
  --job-file FILE      Mount FILE read-only at /ffbox/job.json for the task to read.
  --mount SPEC         Extra bind mount, HOST:CONTAINER[:ro]. Repeatable. Nested paths under
                       the workspace work; Docker creates the intermediate directories.
  --run-id ID          Use ID for the run instead of a timestamp, so the caller owns the
                       ffbox-<ID> container name and can address exactly it later.
  --stage-pool ID      Start a container that fills its workspace and then WAITS for a request,
                       so one that arrives finds it warm. Detached; no job, no clocks, no
                       prompt. It retires itself after --idle-ttl seconds unclaimed.
  --dispatch ID        Give an already-staged container this run's job. From there it is an
                       ordinary run: same clocks, same harvest, same output directory. The
                       container is renamed to ffbox-<run id> as the job goes in.
  --pool-dir PATH      Where staged containers' spool directories live
                       (default ~/ffbox-state/pool).
  --idle-ttl N         How long a staged container waits before retiring (default 14400).
  --agent-class NAME   Which kind of agent container this is: ffagent (default) or ffdev. Both
                       run the same image, task and limits; the name goes on as a label so the
                       two pools can be counted and claimed apart. ffwatch passes the class the
                       conversation was opened with. It does NOT pick the network — that comes
                       from --network, which ffwatch also passes, resolved from that pool's
                       "network" mode; see there.
  --agent-timeout N    Seconds of AGENT working time (default 1800). The clock starts when the
                       task creates <out>/.agent-started, not when ffbox does.
  --warmup-timeout N   Seconds for everything before that marker (default 3600).
  --verify-timeout N   Seconds for the harness verification phase after the agent exits, from
                       <out>/.verify-started (default 1800). Its own clock, so a Unity test run
                       is never mistaken for a hung agent.
  --kill-grace N       Seconds between SIGTERM and force (default 10). Every run holds an
                       editor, so the stop allows at least 120s whatever this says — that is
                       the licence round trip, not the agent. Raise it past 120 to give a
                       stubborn agent longer; lowering it below cannot strand the seat.
  -h, --help           Show this help.

Timeout exit codes: 123 = warm-up ceiling exceeded, 124 = agent ceiling exceeded, 125 =
verification ceiling exceeded (the agent had already finished). Each also writes the word
"warmup", "agent" or "verify" to <results>/ffbox-timeout.

Secrets are read from an env file, never from the command line — anything in argv is visible
in /proc/<pid>/cmdline and lands in shell history. Default location:
  ~/.config/ffbox/secrets.env   (chmod 600; see secrets.env.example)
EOF
}

# --- argument parsing --------------------------------------------------------------------------
while [ $# -gt 0 ]; do
    case "$1" in
        --prompt-file)    PROMPT_FILE=${2:?--prompt-file needs a path}; shift 2 ;;
        --direct)         DIRECT=1; shift ;;
        --keep)           KEEP=1; shift ;;
        --no-fetch)       SKIP_FETCH=1; shift ;;
        --json)           OUTPUT_FORMAT=stream-json; shift ;;
        --image)          IMAGE=${2:?--image needs a name}; shift 2 ;;
        --network)        NETWORK=${2:?--network needs a name}; shift 2 ;;
        --ref)            REF=${2:?--ref needs a git ref}; shift 2 ;;
        --branch)         BRANCH=${2:?--branch needs a name}; shift 2 ;;
        --branch-prefix)  BRANCH_PREFIX=${2:?--branch-prefix needs a prefix}; shift 2 ;;
        --base-refs)      BASE_REFS=${2:?--base-refs needs a list}; shift 2 ;;
        --task)           TASK=${2:?--task needs a path}; CLOCKS=1; shift 2 ;;
        --job-file)       JOB_FILE=${2:?--job-file needs a path}; CLOCKS=1; shift 2 ;;
        --mount)          MOUNTS+=("${2:?--mount needs HOST:CONTAINER[:ro]}"); shift 2 ;;
        --run-id)         RUN_ID_OVERRIDE=${2:?--run-id needs an id}; shift 2 ;;
        --stage-pool)     STAGE_POOL=${2:?--stage-pool needs an id}; shift 2 ;;
        --dispatch)       DISPATCH=${2:?--dispatch needs a pool id}; CLOCKS=1; shift 2 ;;
        --pool-dir)       POOL_DIR=${2:?--pool-dir needs a path}; shift 2 ;;
        --idle-ttl)       IDLE_TTL=${2:?--idle-ttl needs seconds}; shift 2 ;;
        --agent-class)    AGENT_CLASS=${2:?--agent-class needs a name}; shift 2 ;;
        --agent-timeout)  AGENT_TIMEOUT=${2:?--agent-timeout needs seconds}; CLOCKS=1; shift 2 ;;
        --warmup-timeout) WARMUP_TIMEOUT=${2:?--warmup-timeout needs seconds}; CLOCKS=1; shift 2 ;;
        --verify-timeout) VERIFY_TIMEOUT=${2:?--verify-timeout needs seconds}; CLOCKS=1; shift 2 ;;
        --kill-grace)     KILL_GRACE=${2:?--kill-grace needs seconds}; CLOCKS=1; shift 2 ;;
        -h|--help)        usage; exit 0 ;;
        --)               shift; break ;;
        -*)               echo "ffbox: unknown option $1" >&2; usage >&2; exit 2 ;;
        *)                break ;;
    esac
done

for spec in "${MOUNTS[@]}"; do
    case "$spec" in
        /*:/*) ;;
        *) echo "ffbox: --mount needs HOST:CONTAINER[:ro] with absolute paths, got '$spec'" >&2
           exit 2 ;;
    esac
done

if [ -n "$RUN_ID_OVERRIDE" ]; then
    # This becomes a container name, and it is the ONLY handle anything gets for destroying
    # this run's container later. Anything that would need quoting is rejected here rather
    # than producing a container nobody can address.
    case "$RUN_ID_OVERRIDE" in
        *[!A-Za-z0-9._-]*|"") echo "ffbox: --run-id must match [A-Za-z0-9._-]+" >&2; exit 2 ;;
    esac
fi

if [ -n "$BRANCH" ]; then
    # This name reaches `git checkout -B` and later `git push <remote> <branch>` on the host, so
    # anything git would treat as an option or a refspec separator is refused here rather than
    # becoming a surprising ref. Slashes are allowed because ffbox/<run-id> is the whole point.
    case "$BRANCH" in
        -*|*..*|*:*|*[!A-Za-z0-9._/-]*|"")
            echo "ffbox: --branch must match [A-Za-z0-9._/-]+ and not start with '-'" >&2
            exit 2 ;;
    esac
fi

if [ -n "$PROMPT_FILE" ]; then
    [ -r "$PROMPT_FILE" ] || { echo "ffbox: cannot read $PROMPT_FILE" >&2; exit 2; }
    PROMPT=$(cat "$PROMPT_FILE")
elif [ $# -gt 0 ]; then
    PROMPT="$*"
elif [ -z "$TASK" ] && [ ! -t 0 ]; then
    PROMPT=$(cat)
fi

# A task run carries its instructions in its own mounted files (job.json for the Discord lanes),
# so a prompt is required only for the default one-shot task.
if [ -z "$TASK" ] && [ -z "$STAGE_POOL$DISPATCH" ] && [ -z "${PROMPT// }" ]; then
    echo "ffbox: no prompt given" >&2
    usage >&2
    exit 2
fi

# --- one pipeline, several front doors ------------------------------------------------------------
# A plain prompt is an INGRESS, not an execution: it goes to ffwatch as a turn, exactly as a
# Discord message does, and ffwatch launches this same script in executor mode (--task/--job-file)
# to do the work. That is what puts a shell run on the web page, under the same ceilings, kill
# switch, transcript index and recovery as everything else — one path by which Claude is invoked.
#
# Executor mode (--task or --job-file present) never routes: that IS the run ffwatch asked for,
# and routing it would recurse. --direct forces the old behaviour for bootstrapping and for
# debugging the container itself.
FFBOX_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
FFWATCH_PY=${FFWATCH_PY:-$FFBOX_DIR/ffwatch.py}

# THE BOX'S CEILING, shared with the CI lane. Every container this script creates is counted
# against it, and the count includes ffgithubrunners' containers because they hold the same kind of
# workspace on the same daemon. lib-workloads.sh has the why, including why admission lives at the
# point of creation rather than in either scheduler.
#
# Sourcing it is not optional, but a MISSING file is survivable: an old checkout, or somebody
# running ffbox out of a directory holding only the script. Warn, define the no-op and carry on --
# the alternative is a box that cannot start anything because a helper is absent.
if [ -r "$FFBOX_DIR/lib-workloads.sh" ]; then
    . "$FFBOX_DIR/lib-workloads.sh"
else
    echo "ffbox: WARNING: $FFBOX_DIR/lib-workloads.sh is missing; running with no shared ceiling" >&2
    # STUBS THAT MEAN "BEHAVE THE WAY THIS DID BEFORE THE CEILING EXISTED", not stubs that refuse.
    # A missing helper must not be able to stop the box running anything, so: room for everything,
    # no lock, slot 0, and an EMPTY machine id -- which entrypoint.sh reads as "leave the image's
    # own id alone", exactly what every container did until now.
    ffbox_workload_lock_acquire() { return 0; }
    ffbox_workload_lock_release() { return 0; }
    ffbox_workload_has_room() { return 0; }
    ffbox_workload_await_container() { return 0; }
    ffbox_agent_slot_claim() { printf '0\n'; }
    ffbox_agent_machine_id() { printf '\n'; }
    ffbox_agent_slot_confirm() { return 0; }
    ffbox_agent_slot_release() { return 0; }
    FFBOX_WORKLOAD_LABEL=ffbox.workload
fi
if [ "$DIRECT" = 0 ] && [ -z "$TASK" ] && [ -z "$JOB_FILE" ] && [ -z "$STAGE_POOL$DISPATCH" ] \
   && [ -r "$FFWATCH_PY" ]; then
    ROUTE=("python3" "$FFWATCH_PY" "submit" "--wait")
    [ -z "$REF" ] || ROUTE+=("--ref" "$REF")
    [ -z "$BRANCH" ] || ROUTE+=("--branch" "$BRANCH")
    ROUTE+=("$PROMPT")
    exec "${ROUTE[@]}"
fi

# --- secrets ------------------------------------------------------------------------------------
if [ -r "$SECRETS" ]; then
    perms=$(stat -c '%a' "$SECRETS")
    case "$perms" in
        600|400) ;;
        *) echo "ffbox: WARNING: $SECRETS is mode $perms; expected 600" >&2 ;;
    esac
    set -a
    # shellcheck disable=SC1090
    . "$SECRETS"
    set +a
else
    echo "ffbox: WARNING: no secrets file at $SECRETS" >&2
    echo "       Run 'sh ffbox/setup.sh' to create it from the template." >&2
fi

if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    echo "ffbox: CLAUDE_CODE_OAUTH_TOKEN is not set. Generate one with 'claude setup-token'" >&2
    echo "       and put it in $SECRETS — it bills against your subscription, not an API key." >&2
    exit 78
fi

# --- the Unity licence ---------------------------------------------------------------------------
#
# A FILE, MOUNTED READ-ONLY. NOT A CREDENTIAL.
#
# This used to decode a 27-character serial out of the .ulf and pass it in beside UNITY_EMAIL and
# UNITY_PASSWORD, so that the container could perform an online activation on start. It does not any
# more, and nothing here reads those variables even when secrets.env still defines them: a container
# that runs `claude -p --dangerously-skip-permissions` over text strangers wrote should not hold a
# Unity account password, and everything in /proc/self/environ is readable by everything in the
# container. See ffbox/unity-offline-license.sh for how the file is minted and why one file serves
# every container.
#
# MISSING IS A WARNING RATHER THAN A REFUSAL, deliberately. The container says so far more usefully
# than this can -- unity-license.sh knows whether a fallback credential exists and what the machine
# id mismatch would look like -- and refusing here would also block the `--task` runs that never
# launch an editor at all.
# /opt/ffcache, NOT ~/.config: the rootless daemon that performs this mount runs as ffbox-container
# and cannot traverse a mode-700 home. See the long note in unity-offline-license.sh.
UNITY_ULF=${FFBOX_UNITY_ULF_HOST:-/opt/ffcache/unity/Unity_lic.ulf}

# REFRESHED HERE, AT THE MOMENT A CONTAINER IS ABOUT TO BE MADE, and that timing is the whole point.
# A Personal .ulf carries a rolling ~24-hour UpdateDate rather than an annual expiry, so the question
# is never "is it still valid" in the abstract -- it is "will it still be valid for the life of the
# container I am about to start". Only the thing creating the container knows that moment has come,
# which is why this is not a timer.
#
# A POOL WORKER IS THE CASE THAT MOTIVATES IT: it is staged hours before it has a turn, so it wants a
# licence with room to spare rather than one that lapses while it sits idle.
#
# QUIET AND FAST WHEN THERE IS NOTHING TO DO -- one sed over a small file, no docker, no network --
# and NEVER FATAL: a refresh that fails must not stop a run, because the licence in hand may well be
# good enough and unity-license.sh inside the container reports the truth far better than a guess
# made out here.
_FFBOX_LICTOOL=$(dirname "$0")/unity-offline-license.sh
if [ -x "$_FFBOX_LICTOOL" ]; then
    sh "$_FFBOX_LICTOOL" ensure "${FFBOX_LICENCE_MIN_HOURS:-4}" 2>&1 | sed 's/^/[ffbox] /' || :
fi

UNITY_LICENCE_ARGS=()
if [ -r "$UNITY_ULF" ]; then
    # THE DIRECTORY, NOT THE FILE, and the difference decides whether a long run keeps a valid
    # licence. A Personal .ulf carries a rolling ~24-hour UpdateDate, and the host refreshes it by
    # RE-ACTIVATING, which writes a new file. A bind mount of a file pins the inode -- measured on
    # this box 2026-09-03 -- so a container mounted that way holds the licence it was born with
    # for as long as it lives, and any run past about a day is running on a lapsed one. Mounting
    # the directory means the host's refresh is visible to a container that is already up, and
    # unity-license.sh re-copies when it sees a newer file.
    #
    # The path inside is unchanged, so entrypoint.sh and unity-license.sh need to know nothing
    # about this. Read-only, as before: the container reads a licence and never writes one.
    UNITY_LICENCE_ARGS=(
        -v "$(cd "$(dirname "$UNITY_ULF")" && pwd):/ffbox/unity:ro"
        -e "FFBOX_UNITY_ULF=/ffbox/unity/$(basename "$UNITY_ULF")"
    )
else
    echo "ffbox: WARNING: no Unity licence at $UNITY_ULF" >&2
    echo "       Any run that starts the editor will fail. Mint one with:" >&2
    echo "         sh ffbox/unity-offline-license.sh mint" >&2
fi

# --- preflight ------------------------------------------------------------------------------------
command -v docker >/dev/null || { echo "ffbox: docker not found" >&2; exit 127; }
docker image inspect "$IMAGE" >/dev/null 2>&1 || {
    echo "ffbox: image '$IMAGE' not built. Run: ffbox/03-build.sh" >&2
    exit 69
}

# The filtered network fails CLOSED and says so here. A missing network or a stopped proxy is not
# something to fall back from: Docker would happily start the run on the default bridge with the
# whole internet available, and nothing downstream would ever mention it. Checked before the ZFS
# clone rather than after, so a misconfigured machine costs a second instead of a Unity import.
NETWORK_ARGS=(--network "$NETWORK")
case "$NETWORK" in
    bridge|host|none)
        echo "ffbox: WARNING: --network $NETWORK — this run has unfiltered network access," >&2
        echo "       including to this host itself" >&2
        ;;
    *)
        docker network inspect "$NETWORK" >/dev/null 2>&1 || {
            echo "ffbox: network '$NETWORK' does not exist." >&2
            echo "       Run: sh ffbox/egress/ffbox-egress.sh up" >&2
            echo "       Or, deliberately, run unfiltered with: --network bridge" >&2
            exit 69
        }
        if [ "$(docker inspect -f '{{.State.Running}}' "$EGRESS_NAME" 2>/dev/null)" != true ]; then
            echo "ffbox: the egress proxy '$EGRESS_NAME' is not running, so nothing on" >&2
            echo "       '$NETWORK' can resolve a name or reach the model." >&2
            echo "       Run: sh ffbox/egress/ffbox-egress.sh up" >&2
            exit 69
        fi
        NETWORK_ARGS+=(--dns "$DNS")
        ;;
esac

[ -d "$CACHE_ENTRIES" ] || {
    echo "ffbox: no workspace cache at $CACHE_ENTRIES" >&2
    echo "       CI fills it; provision it with ffbox/runners/01-hostSetup.sh" >&2
    exit 69; }

RUN_ID=${RUN_ID_OVERRIDE:-$(date +%Y%m%d-%H%M%S)-$$}
OUT="${RESULTS}/${RUN_ID}"

# --- the pool's directories ---------------------------------------------------------------------
#
# A staged container's mounts are fixed when it is created, so the directory it will read its job
# out of has to exist before there is a job. It is named for the container and deleted with it:
# not a slot, nothing persists across two of them, and no number to allocate.
#
#   in/     read-only to the container, written by the host at dispatch
#   out/    the container's /ffbox/out, moved into the real run directory when the run ends
#   claude/ CLAUDE_CONFIG_DIR for the one turn this container serves
# REFUSED HERE, BEFORE ANYTHING IS CREATED. A name outside the set would otherwise become a
# label no pool ever filters on: the container would be built, staged, hold a workspace and a
# Unity seat, and never be claimed by anything -- a leak that looks like a working run until
# somebody counts containers. ffwatch validates too, and its refusal is the one that matters
# because it is the writer; this one catches a hand-run ffbox and a typo in a script.
case " $AGENT_CLASSES " in
    *" $AGENT_CLASS "*) ;;
    *)  echo "ffbox: --agent-class $AGENT_CLASS is not one of: $AGENT_CLASSES" >&2; exit 2 ;;
esac

# WHAT THIS CLASS'S CONTAINERS ARE CALLED. Both pools stage spares and both run turns, and until
# 2026-09-02 every one of them was `ffbox-pool-<id>` or `ffbox-<run id>` whichever class it
# served -- so `docker ps` could not tell a fenced ffagent spare from a bridged ffdev one, which
# is the whole difference that matters when something is wrong with the network.
#
# DERIVED FROM THE CLASS, not passed in, so it cannot disagree with the ffbox.agent.class label
# the same run carries. The label stays the thing ffwatch filters on -- a name is for the
# operator reading `docker ps`, and nothing schedules off it.
case "$AGENT_CLASS" in
    ffagent) NAME_PREFIX=ffbox-agent- ;;
    ffdev)   NAME_PREFIX=ffbox-dev- ;;
    # Unreachable while this case mirrors AGENT_CLASSES above, which the check just enforced.
    # Stated anyway: a class added to the list and forgotten here must not silently collide with
    # another class's names.
    *)  echo "ffbox: no container-name prefix for agent class $AGENT_CLASS" >&2; exit 2 ;;
esac
POOL_NAME="${NAME_PREFIX}pool-${STAGE_POOL:-$DISPATCH}"
RUN_NAME="${NAME_PREFIX}${RUN_ID}"

POOL_IN=
FINAL_OUT=
if [ -n "$STAGE_POOL$DISPATCH" ]; then
    POOL_ID=${STAGE_POOL:-$DISPATCH}
    case "$POOL_ID" in
        *[!A-Za-z0-9._-]*|"")
            echo "ffbox: a pool id must match [A-Za-z0-9._-]+" >&2; exit 2 ;;
    esac
    [ -n "$STAGE_POOL" ] && [ -n "$DISPATCH" ] && {
        echo "ffbox: --stage-pool and --dispatch are different jobs; pass one" >&2; exit 2; }
    POOL_HOME="$POOL_DIR/$POOL_ID"
    POOL_IN="$POOL_HOME/in"
    if [ -n "$STAGE_POOL" ]; then
        mkdir -p "$POOL_IN" "$POOL_HOME/out" "$POOL_HOME/claude"
        # A LEFTOVER JOB WOULD DISPATCH THE CONTAINER THE MOMENT IT FINISHED STAGING. Refuse the
        # id rather than clearing it: something else believes it owns this directory.
        if [ -n "$(ls -A "$POOL_IN" 2>/dev/null)" ]; then
            echo "ffbox: $POOL_IN is not empty; refusing to stage over it" >&2
            exit 2
        fi
    else
        [ -d "$POOL_HOME" ] || {
            echo "ffbox: no pool container directory at $POOL_HOME" >&2; exit 70; }
        # The run directory the caller asked for is where everything ends up; the container is
        # already writing into the pool's own out, so that is $OUT until it exits.
        FINAL_OUT="$OUT"
        mkdir -p "$FINAL_OUT"
    fi
    OUT="$POOL_HOME/out"
fi

mkdir -p "$OUT"

# THE OUTPUT MOUNT HAS TO BE REACHABLE BY THE CONTAINER'S ROOT, and on the shared daemon that is a
# different account. The container runs as namespace root, which maps to ffbox-container on the
# host; this directory belongs to the invoking user, whose uid is NOT in that daemon's map. It
# shows up inside as 65534, and capabilities in a user namespace do not extend to files owned by
# an unmapped uid — so even root WITH CAP_DAC_OVERRIDE is refused. Measured on 2026-08-29: caps
# a80425fb, DAC_OVERRIDE set, and `touch /ffbox/out/probe` still denied.
#
# The GROUP is the way through, and it needs no privilege: chgrp to a group we are already in.
# ffbox-container maps to gid 0 inside the container, so group-write is write. setgid so anything
# the run leaves behind keeps the group.
if getent group ffbox-container >/dev/null 2>&1; then
    chgrp ffbox-container "$OUT" 2>/dev/null && chmod 2775 "$OUT" 2>/dev/null || {
        echo "[ffbox] WARNING: could not give $OUT to the ffbox-container group;" >&2
        echo "[ffbox]          the container may not be able to write its output." >&2
    }
fi
if [ -n "${PROMPT// }" ]; then
    printf '%s' "$PROMPT" > "$OUT/prompt.txt"
fi

# --- extra mounts --------------------------------------------------------------------------------
DOCKER_MOUNTS=()
for spec in "${MOUNTS[@]}"; do
    host=${spec%%:*}
    if [ ! -e "$host" ]; then
        # Docker would create a missing host path as a ROOT-owned directory, which the
        # host-side caller then cannot write or clean up. Create it as ourselves instead.
        mkdir -p "$host"
    fi
    DOCKER_MOUNTS+=(-v "$spec")
done

ENTRY_ENV=()
if [ -n "$TASK" ]; then
    if [ -r "$TASK" ]; then
        TASK_ABS=$(cd "$(dirname "$TASK")" && pwd)/$(basename "$TASK")
        DOCKER_MOUNTS+=(-v "$TASK_ABS:/ffbox/task.sh:ro")
        ENTRY_ENV+=(-e "FFBOX_ENTRY=/ffbox/task.sh")
    else
        # Not a host file: assume it is a path that already exists inside the image.
        ENTRY_ENV+=(-e "FFBOX_ENTRY=$TASK")
    fi
fi
if [ -n "$JOB_FILE" ]; then
    [ -r "$JOB_FILE" ] || { echo "ffbox: cannot read $JOB_FILE" >&2; exit 2; }
    JOB_ABS=$(cd "$(dirname "$JOB_FILE")" && pwd)/$(basename "$JOB_FILE")
    DOCKER_MOUNTS+=(-v "$JOB_ABS:/ffbox/job.json:ro")
    ENTRY_ENV+=(-e "FFBOX_JOB_FILE=/ffbox/job.json")
fi

# --- lifecycle ---------------------------------------------------------------------------------
# THE ID, WRITTEN WHERE A LATER PROCESS CAN FIND IT. The host records it against the run, and the
# database write happens after this script returns -- so if we die in between, the answer is still
# on disk and the next pass can pick it up. Inside `out/` rather than beside it, so it travels
# with the move a dispatched run's directory makes at the end.
#
# Never fatal. A run whose id was not written down is found by name or by its ffbox.run.id label,
# which is what those exist for; failing the run over a bookkeeping file would be the wrong trade.
ffbox_write_container_id() {
    [ -n "${1:-}" ] || return 0
    printf '%s\n' "$1" > "$OUT/container-id" 2>/dev/null || :
    return 0
}

# THE RUN'S CEILINGS, ON DISK, SO SOMETHING OTHER THAN THIS PROCESS CAN ENFORCE THEM.
#
# The clock loop below holds the three ceilings in shell variables and compares them against
# marker mtimes every two seconds. lib-workloads.sh's own header says what is wrong with that,
# about the CI lane: "a deadline held in a shell variable cannot be read by anything else ... and
# it dies with the process holding it, so a SIGKILLed supervisor leaves a container running with
# no deadline at all". The agent lane's clocks are exactly those variables.
#
# WHY THE CEILINGS AND NOT A DEADLINE. A deadline would have to be rewritten at every phase
# change, by somebody, and that somebody would be a process again. The phase markers the task
# already writes -- .agent-started and .verify-started -- carry their own start times in their
# mtimes, so a reader can derive which phase is in flight and how long it has been in it with no
# state of its own. What it cannot derive is which ceilings this run was created under, and that
# is what this file is for.
#
# THAT MATTERS BECAUSE CONFIG MOVES. A run started under agent_secs=1800 keeps 1800 even if the
# file says 3600 an hour later, which is the same rule lib-workloads.sh applies to the pool's
# idle clock and for the same reason: a setting applies to containers made afterwards and never
# retroactively.
#
# Never fatal. A run whose ceilings were not written down is bounded by this script's own loop,
# which is where every run was before this existed.
ffbox_write_clock() {
    {
        printf 'started_at=%s\n' "$(date -Is)"
        printf 'warmup_secs=%s\n' "$WARMUP_TIMEOUT"
        printf 'agent_secs=%s\n' "$AGENT_TIMEOUT"
        printf 'verify_secs=%s\n' "$VERIFY_TIMEOUT"
        printf 'kill_grace_secs=%s\n' "$KILL_GRACE"
    } > "$OUT/clock" 2>/dev/null || :
    return 0
}

cleanup() {
    local rc=$?
    set +e

    # Stop rather than kill: SIGTERM reaches run-as-user.sh as PID 1 so it can hand the Unity
    # activation seat back before dying. A killed container leaks the seat.
    if docker ps -q --filter "name=${RUN_NAME}" | grep -q .; then
        echo "[ffbox] stopping container (allowing license return)..." >&2
        docker stop --timeout 120 "$RUN_NAME" >/dev/null 2>&1
    fi

    # AND REMOVE IT, because --rm no longer does. By the time this runs everything worth reading
    # has been read: the exit code is in out/.container-rc and the harvest has already run off
    # $OUT. A cold run's container is this script's to remove; a DISPATCHED one is the pool's,
    # and pool_drop/pool_reap remove it along with the spool -- removing it here would take it
    # out from under a keeper that is still deciding what to do with the directory.
    if [ -z "$DISPATCH" ] && [ -n "${RUN_NAME:-}" ]; then
        docker rm -f "$RUN_NAME" >/dev/null 2>&1 || :
    fi

    if [ "$KEEP" = 1 ]; then
        echo "[ffbox] --keep: nothing to keep — the workspace was a container ramdrive" >&2
        echo "[ffbox]         the run's output is at $OUT" >&2
    else
        : # the kernel freed the workspace when the container exited
    fi
    return $rc
}
trap cleanup EXIT INT TERM

# --- git identity and harvest ceilings -----------------------------------------------------------
# The agent commits its OWN work now (WRITE_ALLOWED in ffwatch.py grants local git), so the
# clone carries the identity those commits get and the harvest checks every commit against it.
# A commit claiming somebody else is how an agent would dress its work up as a human's, and it
# would reach a reviewer looking exactly like one.
FFBOX_GIT_NAME=${FFBOX_GIT_NAME:-ffbox}
FFBOX_GIT_EMAIL=${FFBOX_GIT_EMAIL:-ffbox@final-factory.invalid}

# Ceilings on what one run may publish. Not a security boundary — the agent could stay under
# either one — but a runaway `git add -A` over a re-imported Library/ is a mistake worth
# catching before it becomes a 40GB push.
MAX_CHANGED_FILES=${FFBOX_MAX_CHANGED_FILES:-2000}
# PATHS THIS PIPELINE NEVER PUBLISHES. A pushed branch is code execution on the build machine:
# FinalFactory's .github/workflows/main.yml is `on: [push, pull_request]` and `runs-on:
# self-hosted`, with the Unity account and GITHUB_TOKEN in scope, and GitHub runs the workflow
# AS IT EXISTS ON THE PUSHED BRANCH rather than the one on develop. So an agent that edits one
# has its own steps run with real secrets before a human reads the diff, and the verification
# gate cannot catch it: that gate asks whether the change compiles and passes tests, and a
# workflow payload does both while the code beside it is perfectly good.
FORBIDDEN_PATHS_RE=${FFBOX_FORBIDDEN_PATHS_RE:-^\.github/}
MAX_BUNDLE_BYTES=${FFBOX_MAX_BUNDLE_BYTES:-268435456}

# Branches a run may not END on. The agent is told to make its own branch and told what happens
# if it does not; this is the half that makes the telling true. Work committed onto develop or
# master is a change to the integration branch itself dressed up as a proposal — the range would
# still bundle and still push, and the reviewer would have no way to see which it was.
#
# It is deliberately about where HEAD ENDS UP, not about which commits exist. An agent that
# committed on develop and then branched off it publishes that work on the branch, which is the
# outcome everybody wants; what is refused is finishing the run on the shared branch.
PROTECTED_BRANCHES=${FFBOX_PROTECTED_BRANCHES:-develop master main}



# Refuse to publish, and say why in a file ffwatch reads back as the run's no_branch_reason.
# Without this the host cannot tell "the harvest broke" from "the run changed nothing", and
# those two want very different replies.
harvest_failed() {
    printf '%s\n' "$1" > "$OUT/harvest_error.txt"
    rm -f "$OUT/work.bundle" "$OUT/branch.txt" "$OUT/publish_base.txt"
    echo "ffbox: harvest refused: $1" >&2
}

echo "[ffbox] run $RUN_ID"

# --- workspace: CI's cache tar, then the commits since, from the local mirror -----------------
#
# WHAT THIS REPLACED. A run used to be a ZFS clone of golden: take the golden lock, fast-forward
# /opt/FinalFactory to origin, zfs snapshot, zfs clone. That needed golden to exist, to be current,
# and to carry a warm Library built by opening the project in Unity every five minutes. All of it
# is gone, updater script included. CI already writes a tar of a whole finished workspace --
# worktree, .git and that same Library -- and the local git mirror has the commits since.
#
# THE COST, MEASURED: about 35 seconds to restore a 22 GB entry onto the ramdrive, against a
# near-instant copy-on-write clone. Not free, but the same order as the ZFS clone it replaced and
# far from the 193 seconds the same extract takes on the spinning mirror -- which is what this
# path did before the workspace moved to /dev/shm.
#
# NO SUDO, and that is a real reduction rather than a side effect: with no snapshot and no clone,
# the narrow NOPASSWD rules for zfs snapshot/clone/destroy have nothing left to authorise.
#
# THE AGENT ONLY EVER READS THE CACHE. Extraction happens here, on the host, from a directory the
# container never sees; the run cannot write back into an entry that later runs restore from.
# Which entry. The branch asked for, then the default branch, then whatever ran most recently at
# this editor version -- the same ladder main.yml's restore uses, so both modes agree on what a
# usable entry is.
[ -n "$UNITY_SCOPE" ] || UNITY_SCOPE=$(
    git -C "$MIRROR_REPO_PATH" show "refs/heads/master:ProjectSettings/ProjectVersion.txt" 2>/dev/null \
      | sed -n 's/^m_EditorVersion: *//p' | tr -d ' \r')
ENTRY=
_want_branch=${REF:-master}
_safe_branch=$(printf '%s' "$_want_branch" | sed 's|^origin/||; s/[^a-zA-Z0-9._-]/-/g')
for _cand in "$_safe_branch" master; do
    [ -n "$_cand" ] || continue
    if [ -f "$CACHE_ENTRIES/$_cand@$UNITY_SCOPE.tar" ]; then
        ENTRY="$CACHE_ENTRIES/$_cand@$UNITY_SCOPE.tar"; break
    fi
done
[ -n "$ENTRY" ] || ENTRY=$(find "$CACHE_ENTRIES" -maxdepth 1 -type f -name '*.tar' -printf '%T@ %p\n' 2>/dev/null \
                            | sort -rn | head -1 | cut -d' ' -f2-)
[ -n "$ENTRY" ] || {
    echo "ffbox: no usable cache entry in $CACHE_ENTRIES" >&2
    echo "       one CI job on master creates one." >&2
    exit 69; }

# REFUSE RATHER THAN FILL THE RAMDRIVE. The workspace lives in memory, so running out is not a
# failed run -- it is memory taken from CI jobs and everything else on the box. Half the headroom
# again on top of the entry covers what the run itself then writes.
# Golden tracked master, so a run with no --ref used to land on master. Keep that.
[ -n "$REF" ] || REF=master

# --- how the workspace reaches the container ---------------------------------------------------
#
# TMPFS: the container gets an empty ramdrive with its own size=, fills it itself from the cache
# entry and the mirror, and harvests to /ffbox/out before it exits. Nothing about the workspace
# exists on a host path, the kernel frees it when the container goes, and the host never runs git
# in a tree a container wrote -- which deletes finding F7's hazard rather than mitigating it.
#
# CLONE: the host-prepared directory above, bind-mounted. Still the default until the harvest
# exec, because Docker's tmpfs default is noexec and Unity, git hooks and node all run from the
# workspace.
#
# gid=0, NOT the host's ffbox-container gid. A bind mount carries host ownership through the
# rootless map, so host gid 1020 shows up as gid 0 inside; a tmpfs Docker CREATES does not -- the
# gid= is taken in the container's namespace, and 1020 is not a group in there at all. Passing it
# left the tree owned by an unknown group, the agent could not write a single file outside .git,
# and it reported the workspace as root-owned. entrypoint.sh drops to uid 1000 keeping GROUP 0,
# which is exactly what this hands it. Found on the second real run.

# THE WORKSPACE PATH IS CI'S PATH, and that is the entire reason it is not /workspace.
#
# Unity caches its package resolution in Library/PackageManager/projectResolution.json, and that
# file records ABSOLUTE paths -- the project, its Packages/manifest.json and packages-lock.json,
# and the editor's BuiltInPackagesCombined.sha1. The cache entry is CI's finished workspace, so
# every one of those paths is the runner's. Restore it anywhere else and not one of them exists,
# UPM throws the whole cached resolution away, and it re-resolves from the registry on EVERY
# editor launch.
#
# WHAT THAT MEANS FOR A RUN. A cold resolve reads package TARBALLS, not the extracted
# Library/PackageCache, so the editor image's offline tgz repo has to carry each package at
# exactly the locked version. It carries 27 of this project's 37 registry packages. The other
# ten go to the registry: entities 1.4.7 against the image's 1.4.6, collections 2.6.7 against
# 2.6.6, cinemachine, ide.visualstudio, localization, services.multiplayer, entities.graphics,
# plus jobs, pipeline and vectorgraphics which the image does not carry at all.
#
# So every editor launch reached over the fence for ten tarballs it already had extracted, and
# runs 26, 27, 35 and 36 died at `unity exit 1 after 6s` with compiled=false when the fence was
# refusing that host. THE FENCE WAS THE PROXIMATE CAUSE THERE and is fixed separately (63ad268,
# 30e62b1); a staged container has compiled and passed 774 tests since. What is fixed here is
# why the fence mattered at all -- a run that never resolves cannot be broken by a registry it
# never asks, by an allowlist entry nobody restarted, or by Unity's CDN having a bad afternoon.
#
# Mounted at the runner's path all three inputs line up, the editor image being shared by both
# lanes, and UPM does not resolve at all. CI mounts its own tmpfs at /opt/actions-runner/_work
# (ffbox/runners/lib/config.sh), so nothing on the HOST is at this path and the two lanes cannot
# collide: they are different containers with different tmpfs. Docker creates the intermediate
# directories.
WORKSPACE_PATH=/opt/actions-runner/_work/FinalFactory/FinalFactory

WORKSPACE_ARGS=(
    --tmpfs "$WORKSPACE_PATH:size=${WORKSPACE_SIZE},exec,mode=0755,uid=1000,gid=0"
    -v "$CACHE_ENTRIES:/ffcache:ro"
    -v "$MIRROR_REPO_PATH:/ffmirror:ro"
)
WORKSPACE_ENV=(
    -e "FFBOX_WORKSPACE=$WORKSPACE_PATH"
    -e "FFBOX_CACHE_ENTRY=/ffcache/$(basename "$ENTRY")"
    -e "FFBOX_MIRROR=/ffmirror"
    -e "FFBOX_REF=$REF"
    -e "FFBOX_BRANCH=$BRANCH"
    -e "FFBOX_BRANCH_PREFIX=$BRANCH_PREFIX"
    -e "FFBOX_BASE_REFS=$BASE_REFS"
    -e "FFBOX_RUN_ID=$RUN_ID"
    -e "FFBOX_GIT_NAME=$FFBOX_GIT_NAME"
    -e "FFBOX_GIT_EMAIL=$FFBOX_GIT_EMAIL"
)
echo "[ffbox] workspace: container ramdrive, ${WORKSPACE_SIZE} cap, from $(basename "$ENTRY")"

# A ZFS CLONE IS A DIFFERENT DATASET, SO EVERY FILE'S st_dev CHANGES. Git records dev and inode
# in the index, so the first `git status` in a clone disagrees with the index about all 26,677
# tracked files and re-hashes the entire worktree. Measured on a real clone of golden on
# 2026-08-31: 5.7s cold against 0.084s warm, from the host with the page cache already hot —
# in the container, cold, with the LFS filters attached, it is the dominant cost of answering a
# question that changed nothing.
#
# core.checkStat=minimal compares size and mtime and ignores dev/inode/ctime, which is exactly
# the set a clone perturbs and none of the set that tells us a file really changed. This is the
# same finding ffcache recorded for the tar path (design/ffcache_tasks.md: 124 of 130 seconds,
# 0.05s with the flag); the ZFS path reaches it by a different route and never got the fix.
#
# NO safe.directory HERE ANY MORE. The host used to need it because it ran git in a workspace
# owned by ffbox-container. It runs git in exactly one place now -- the scratch clone
# harvest_from_out makes from the mirror -- and both belong to this account.

# --- what used to happen here ------------------------------------------------------------------
#
# Checking out the ref, recording base_sha, creating the work branch, setting the git identity and
# writing core.checkStat all used to happen on the host, against a workspace it could see. They
# live in restore-workspace.sh now, because the workspace is a ramdrive the host never touches.
#
# The BASELINE CLEANING that was here is not moved, it is obsolete. It existed because a run was a
# ZFS clone of golden and golden could carry stray edits, so the harness restored tracked paths and
# deleted untracked ones before the agent started. A workspace extracted fresh from a tar and reset
# to a commit cannot be dirty, so there is nothing to clean and split_status_z has no callers.

# --- run -----------------------------------------------------------------------------------------
# Secrets go in as environment variables read from the host-side env file. They are never baked
# into the image and never appear in argv.
PROMPT_MOUNT=()
if [ -f "$OUT/prompt.txt" ]; then
    PROMPT_MOUNT=(-v "$OUT/prompt.txt:/ffbox/prompt.txt:ro")
fi

# EVERY MODE STARTS FROM THE SAME ARGUMENT LIST, which is the only reason a pooled run and a
# cold run can be trusted to behave alike. Staging differs by three things -- it detaches, it
# carries a label and a pool name, and its entry is pool-task.sh -- and dispatch differs by
# starting no container at all.
RUN_ARGS=(
    --hostname ffbox
    # WHICH AGENT CLASS THIS CONTAINER SERVES. In the SHARED list rather than at the two
    # `docker run` sites below, because the value is the same for a staged container and a cold
    # run -- unlike ffbox.workload, which is genuinely `pool` for one and `agent` for the other
    # and stays where it is. A label a caller can forget on one path is how the two pools would
    # start miscounting each other.
    --label "ffbox.agent.class=$AGENT_CLASS"
    --memory "$MEMORY"
    --pids-limit "$PIDS_LIMIT"
    --cap-drop=ALL
    "${CAP_ADD_ARGS[@]}"
    --security-opt=no-new-privileges
    "${NETWORK_ARGS[@]}"
    "${WORKSPACE_ARGS[@]}"
    "${PROMPT_MOUNT[@]}"
    "${DOCKER_MOUNTS[@]}"
    "${ENTRY_ENV[@]}"
    "${UNITY_LICENCE_ARGS[@]}"
    -e CLAUDE_CODE_OAUTH_TOKEN
    -e CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
    -e DISABLE_AUTOUPDATER=1
    -e FFBOX_OUTPUT_FORMAT="$OUTPUT_FORMAT"
    "${WORKSPACE_ENV[@]}"
)

if [ -n "$STAGE_POOL" ]; then
    # --- stage ---------------------------------------------------------------------------------
    #
    # Fill a workspace before anybody has asked for anything. Detached, because the caller wants
    # to go on scheduling: the container's own `staged` file is how it says it is warm, and the
    # keeper reads that rather than waiting here.
    #
    # NO CLOCKS. A staged container has nothing to exceed -- it holds a deadline of its own
    # instead (FFBOX_IDLE_TTL_SECS, enforced in pool-task.sh) and retires by itself.
    #
    # THE LABEL CARRIES THE BRANCH, so the keeper can count what is staged and tell what each one
    # can serve with one `docker ps` and no bookkeeping of its own.
    echo "[ffbox] staging a pool container on ${REF} (ttl ${IDLE_TTL}s)"
    set +e
    # ADMITTED LIKE ANY OTHER CONTAINER. A staged container has been asked to do nothing, and it
    # still holds a 22 GiB workspace; the ceiling is about what the box is carrying, not about
    # what the container has been told to do.
    #
    # THE SLOT IS CLAIMED HERE, UNDER THE SAME LOCK, and it has to be: the id this container will
    # present to Unity is derived from the number, and choosing one has to be inseparable from
    # creating the container that holds it. It is claimed at STAGE time and kept for the whole
    # idle life of the container, because /etc/machine-id is written when a container STARTS and
    # this one starts hours before it has a turn.
    _POOL_SLOT=""
    _rc=0
    # BOUNDED, because staging is speculative. Nobody is waiting on a warm container, and a
    # staging attempt that blocks is worse than one that does not happen: the keeper calls this
    # from ffwatch's own loop, so a wait here is a wait on every reply the daemon has queued.
    # The cold-run path below still waits without a bound -- there, somebody IS waiting.
    if ! ffbox_workload_lock_acquire "${FFBOX_STAGE_LOCK_WAIT:-30}"; then
        echo "ffbox: could not take the admission lock; not staging" >&2
        _rc=77
    elif ! ffbox_workload_has_room; then
        ffbox_workload_lock_release
        _rc=77
    else
        _POOL_SLOT=$(ffbox_agent_slot_claim "$POOL_NAME")
        if [ -z "$_POOL_SLOT" ]; then
            # Every number is held by something that is running. The ceiling should have caught
            # this first, so it means the two disagree -- say so rather than staging an unnumbered
            # container that would collide with a live one at the licence.
            echo "ffbox: no free agent slot; not staging" >&2
            ffbox_workload_lock_release
            _rc=77
        else
            _MID=$(ffbox_agent_machine_id "$_POOL_SLOT")
            # 9>&- for the same reason as the cold path below: fd 9 is the admission lock and
            # nothing that outlives the release may carry it. `docker run -d` returns in a
            # moment, so this has never leaked -- it is closed anyway, because the rule is
            # about the descriptor and not about how long a particular command usually takes.
            # NO --rm HERE EITHER, and it has to be this way round: flags are creation-time and
            # dispatch only RENAMES this container, so a staged container created with --rm stays
            # a --rm container for the whole of the run it eventually serves. Leaving it would
            # give the two routes different lifetimes at exactly the point the host starts
            # depending on them being the same. pool_drop and pool_reap remove it explicitly.
            _CID=$(docker run -d \
                --name "$POOL_NAME" \
                --label "$FFBOX_WORKLOAD_LABEL=pool" \
                --label "ffbox.pool=${REF}" \
                --label "ffbox.pool.id=${STAGE_POOL}" \
                --label "ffbox.slot=${_POOL_SLOT}" \
                "${RUN_ARGS[@]}" \
                -v "$POOL_IN:/ffbox/in:ro" \
                -v "$OUT:/ffbox/out" \
                -e "FFBOX_IN=/ffbox/in" \
                -e "FFBOX_IDLE_TTL_SECS=$IDLE_TTL" \
                -e "FFBOX_MACHINE_ID=$_MID" \
                "$IMAGE" 9>&-)
            _rc=$?
            if [ "$_rc" -eq 0 ]; then
                # By ID rather than by name, because dispatch renames this container to its run
                # and an id does not move.
                ffbox_agent_slot_confirm "$_POOL_SLOT" "$_CID"
                echo "[ffbox] agent slot ${_POOL_SLOT} (Unity sees this slot as its own machine)"
            else
                ffbox_agent_slot_release "$_POOL_SLOT"
            fi
            ffbox_workload_lock_release
        fi
    fi
    set -e
    # 77 is the ceiling refusing, not docker failing, and the keeper reads it to tell a box that
    # is full from a box that is broken. Neither is fatal to anything: the pool simply stays
    # smaller than it was asked to be until something finishes.
    if [ "$_rc" -eq 77 ]; then
        echo "[ffbox] not staging: the box is at its container ceiling" >&2
        exit 77
    fi
    [ "$_rc" -eq 0 ] || { echo "ffbox: could not stage ${POOL_NAME}" >&2; exit "$_rc"; }
    echo "[ffbox] staged ${POOL_NAME}"
    exit 0
fi

set +e
if [ -n "$DISPATCH" ]; then
    # --- dispatch ------------------------------------------------------------------------------
    #
    # The container is already up with its workspace filled. Everything the run needs goes into
    # the directory it is already reading, and `dispatch` goes in LAST -- pool-task.sh waits on
    # that one file, so anything written after it would be a job the container might miss.
    #
    # THE ENV FILE IS WHAT A COLD RUN PASSES AS -e. It cannot be passed that way here because the
    # container exists already, so pool-task.sh reads it and exports it. Same names, same values.
    {
        printf 'FFBOX_REF=%s\n' "$REF"
        printf 'FFBOX_BRANCH=%s\n' "$BRANCH"
        printf 'FFBOX_BRANCH_PREFIX=%s\n' "$BRANCH_PREFIX"
        printf 'FFBOX_BASE_REFS=%s\n' "$BASE_REFS"
        printf 'FFBOX_RUN_ID=%s\n' "$RUN_ID"
        printf 'FFBOX_GIT_NAME=%s\n' "$FFBOX_GIT_NAME"
        printf 'FFBOX_GIT_EMAIL=%s\n' "$FFBOX_GIT_EMAIL"
        printf 'FFBOX_OUTPUT_FORMAT=%s\n' "$OUTPUT_FORMAT"
    } > "$POOL_IN/env"
    [ -f "$OUT/prompt.txt" ] && cp "$OUT/prompt.txt" "$POOL_IN/prompt.txt"
    [ -n "$JOB_FILE" ] && cp "$JOB_FILE" "$POOL_IN/job.json"

    # THE NAME MOVES WITH THE JOB. Every handle downstream -- the stop below, ffwatch's
    # container_live(), anything an operator types -- expects this class's RUN name, and renaming
    # is cheaper than teaching all of them that a pooled run is called something else. Verified on
    # this box's rootless daemon: a running container renames, and `docker ps --filter name=` and
    # `docker exec` follow it immediately.
    #
    # BOTH NAMES COME FROM THE SAME $AGENT_CLASS, which is why ffwatch passes --agent-class on the
    # dispatch route too and not just the cold one. Dispatched under the wrong class this looks
    # for another pool's spare, finds nothing, and exits 70 -- loudly, rather than renaming a
    # container that is serving somebody else.
    if ! docker rename "$POOL_NAME" "$RUN_NAME" 2>/dev/null; then
        echo "ffbox: pool container ${POOL_NAME} is gone; nothing dispatched" >&2
        set -e
        exit 70
    fi
    : > "$POOL_IN/dispatch"
    echo "[ffbox] dispatched into the pool container as ${RUN_NAME}"
    # The id of the container this run is now in. Written on this route too, and by id rather
    # than by the name we have just moved, so the host has one answer to "which container is
    # this run" whichever way the run started.
    ffbox_write_container_id "$(docker inspect --format '{{.Id}}' "$RUN_NAME" 2>/dev/null)"
    # The clock starts at DISPATCH for a pooled run, not at the container's creation: it has been
    # sitting warm and idle, and none of that time is this run's warm-up.
    ffbox_write_clock

    # `docker wait` prints the container's exit code and exits 0 itself, so the code has to come
    # out of its stdout rather than out of $?. Backgrounded so the clock loop below watches this
    # exactly as it watches a `docker run`.
    #
    # INSIDE `out/`, NOT BESIDE IT. This used to land in $POOL_HOME, one level up, so it did not
    # travel with the move below and had to be deleted separately. In `out/` there is one path
    # that answers "what did this container exit with" -- the same path on both routes, before
    # and after the move, and readable by a process that did not start the run.
    docker wait "$RUN_NAME" > "$OUT/.container-rc" 2>/dev/null &
    DOCKER_PID=$!
else
    # THE CEILING, TAKEN THE LONG WAY ROUND. This `docker run` is not detached -- it stays in the
    # foreground for the whole run so the clock loop below can watch it -- so the lock cannot wrap
    # it the way it wraps a staged container. Acquire, count, start, wait for the container to
    # exist, release: the window the lock has to cover is "counted but not yet countable", and
    # holding it any longer would stop CI admitting anything for the length of a run.
    if ! ffbox_workload_lock_acquire; then
        echo "ffbox: could not take the admission lock; refusing rather than overshooting" >&2
        exit 77
    fi
    if ! ffbox_workload_has_room; then
        ffbox_workload_lock_release
        echo "ffbox: the box is at its container ceiling; not starting ${RUN_NAME}" >&2
        exit 77
    fi
    # The number this run presents to Unity, claimed inside the same lock for the same reason as
    # the staged path above. A cold run reaches an editor whenever it verifies, and two runs on
    # one machine id is the exit-198 collision ffgithubrunners already measured.
    RUN_SLOT=$(ffbox_agent_slot_claim "$RUN_NAME")
    if [ -z "$RUN_SLOT" ]; then
        ffbox_workload_lock_release
        echo "ffbox: no free agent slot; not starting ${RUN_NAME}" >&2
        exit 77
    fi
    RUN_MACHINE_ID=$(ffbox_agent_machine_id "$RUN_SLOT")
    echo "[ffbox] agent slot ${RUN_SLOT} (Unity sees this slot as its own machine)"
    # 9>&- CLOSES THE ADMISSION LOCK IN THE CHILD, and it is not optional. fd 9 is the lock,
    # held open by `exec 9>>` in this shell, and a background command inherits every open
    # descriptor -- so this `docker run`, which stays up for the whole run, kept the lock's open
    # file description alive long after the release below closed OUR copy of it. flock is held
    # until the LAST descriptor on that description goes, so the box's admission lock was held
    # for the length of every cold run.
    #
    # WHAT THAT COST, measured on the build server 2026-09-02: `ffbox --stage-pool` blocks on
    # `flock 9` with no timeout, so every pool staging attempted during a run waited forever and
    # ffwatch killed it at its 180-second ceiling -- and keep_pool() runs on the daemon's own
    # loop, so ffwatch froze for three minutes a pass. Reactions and replies that were composed
    # and queued sat there. From Discord it looked exactly like Max had stopped answering.
    # WHICH RUN THIS CONTAINER IS SERVING, AS A LABEL. A label is set at creation and survives
    # `docker rename`, which is the whole reason it is here and the name is not: a pooled
    # container is renamed at dispatch, so anything that identifies a container by name is only
    # true between two renames. A cold container is never renamed, so this label is the same
    # answer for its whole life, and it is what lets a process that did not start the run find
    # it. The dispatch route has no equivalent to add -- a mount, a label and a network are all
    # creation-time, and that container was created before it knew which run it would serve --
    # so it is found by the ffbox.pool.id label it already carries.
    # design/ffbox_live_update_design.txt section 4a.
    # NO --rm, AND THAT IS THE POINT. Measured on this box on 2026-09-03: `--rm` is performed by
    # the DAEMON, so a client that is killed leaves the container to exit and be removed with
    # nobody able to ask what it exited with. `docker logs` goes the same way. The exit code is
    # the one fact a run cannot be scored without, and on 2026-09-01 losing it turned a run that
    # verified 774/774 clean into "the run failed". The container is removed explicitly instead --
    # by this script's cleanup below while it is the one waiting, and by ffwatch's sweep for a
    # container whose host process did not come back.
    docker run \
        --name "$RUN_NAME" \
        --label "$FFBOX_WORKLOAD_LABEL=agent" \
        --label "ffbox.slot=${RUN_SLOT}" \
        --label "ffbox.run.id=${RUN_ID}" \
        "${RUN_ARGS[@]}" \
        -v "$OUT:/ffbox/out" \
        -e "FFBOX_MACHINE_ID=$RUN_MACHINE_ID" \
        "$IMAGE" 9>&- &
    DOCKER_PID=$!
    ffbox_workload_await_container "$RUN_NAME" "$DOCKER_PID"
    # The id, now that there is one. A container that never came up leaves the claim naming it,
    # and the next scan recycles the number because nothing by that name is running.
    RUN_CID=$(docker inspect --format '{{.Id}}' "$RUN_NAME" 2>/dev/null)
    ffbox_agent_slot_confirm "$RUN_SLOT" "$RUN_CID"
    ffbox_write_container_id "$RUN_CID"
    ffbox_write_clock
    ffbox_workload_lock_release
fi

TIMEOUT_KIND=
if [ "$CLOCKS" = 1 ]; then
    # Two clocks, watched from out here because only the host can tell the difference between
    # "Unity is still importing" and "the agent has hung". The task marks the handover by
    # creating .agent-started in the shared out directory.
    STARTED_AT=$(date +%s)
    while kill -0 "$DOCKER_PID" 2>/dev/null; do
        sleep 2
        NOW=$(date +%s)
        # Newest marker wins: the task creates .agent-started when the model starts and
        # .verify-started when the harness's own Unity run starts, so the phase in flight is the
        # one with the latest marker and each phase is judged against its own ceiling.
        if [ -f "$OUT/.verify-started" ]; then
            MARK=$(stat -c %Y "$OUT/.verify-started" 2>/dev/null || echo "$NOW")
            if [ "$VERIFY_TIMEOUT" -gt 0 ] && [ $((NOW - MARK)) -gt "$VERIFY_TIMEOUT" ]; then
                TIMEOUT_KIND=verify
                break
            fi
        elif [ -f "$OUT/.agent-started" ]; then
            MARK=$(stat -c %Y "$OUT/.agent-started" 2>/dev/null || echo "$NOW")
            if [ "$AGENT_TIMEOUT" -gt 0 ] && [ $((NOW - MARK)) -gt "$AGENT_TIMEOUT" ]; then
                TIMEOUT_KIND=agent
                break
            fi
        elif [ "$WARMUP_TIMEOUT" -gt 0 ] && [ $((NOW - STARTED_AT)) -gt "$WARMUP_TIMEOUT" ]; then
            TIMEOUT_KIND=warmup
            break
        fi
    done
    if [ -n "$TIMEOUT_KIND" ]; then
        # Never `docker kill`: the task is PID 1 and its trap is what returns the Unity seat.
        # Every run holds an editor now, so 120s is a FLOOR rather than a special case: that is
        # the licence round trip, and kill_grace is about an agent ignoring SIGTERM. Whichever
        # is larger wins, so an operator who asked for a longer grace still gets it.
        STOP_TIMEOUT=$KILL_GRACE
        [ "$STOP_TIMEOUT" -ge 120 ] || STOP_TIMEOUT=120
        echo "[ffbox] $TIMEOUT_KIND ceiling exceeded — stopping ${RUN_NAME}" >&2
        printf '%s\n' "$TIMEOUT_KIND" > "$OUT/ffbox-timeout"
        docker stop --timeout "$STOP_TIMEOUT" "$RUN_NAME" >/dev/null 2>&1
    fi
fi

wait "$DOCKER_PID"
RUN_RC=$?
set -e

if [ -n "$DISPATCH" ]; then
    # `docker wait` exits 0 having PRINTED the container's code, so $? above is its own success
    # and not the run's. An unreadable file means the container went away without docker wait
    # seeing it end, which is a failed run rather than a successful one.
    RUN_RC=$(tr -dc '0-9' < "$OUT/.container-rc" 2>/dev/null || true)
    [ -n "$RUN_RC" ] || RUN_RC=70

    # EVERYTHING THE RUN PRODUCED MOVES TO THE RUN DIRECTORY, and from here on nothing downstream
    # knows this was a pooled run: the harvest validation, the hints and ffwatch all read $OUT.
    # A rename within one filesystem, so it costs nothing even with a transcript in it.
    (
        shopt -s dotglob nullglob
        for _f in "$OUT"/*; do
            mv -f "$_f" "$FINAL_OUT"/ 2>/dev/null || cp -a "$_f" "$FINAL_OUT"/ 2>/dev/null || true
        done
    )
    OUT="$FINAL_OUT"
    # The container is gone and so is anything it could still be told. What is left under
    # POOL_HOME is this run's leavings, and the keeper deletes the directory; the transcript is
    # the one thing that must be taken out first, which is ffwatch's job and not this script's.
    # `.container-rc` needs no cleanup any more: it lives in `out/` and moved with the rest.
fi

case "$TIMEOUT_KIND" in
    warmup) RUN_RC=123 ;;
    agent)  RUN_RC=124 ;;
    verify) RUN_RC=125 ;;
esac

# --- harvest, when the workspace was a container ramdrive --------------------------------------
#
# There is no tree to run git in: it was a tmpfs and it is gone. harvest-workspace.sh turned the
# run's work into files under $OUT before the container exited, and this re-derives every check
# from the one file that carries evidence rather than assertion -- work.bundle.
#
# WHY RE-DERIVE AT ALL. The container ran the same checks, and its own header says so. But it also
# wrote branch.txt and changed_files.txt, and a run that skipped or lied about its checks would be
# taken at its word if the host merely read them. The bundle cannot lie: git verifies its
# prerequisite, and every commit, author and path below is read out of it here. The container's
# files are used for INTENT -- which branch, which base -- and the bundle for FACT.
#
# The scratch repo is `clone --shared`, so it is alternates pointing at the mirror rather than a
# copy: instant, and no gigabyte of objects moved to check a five-kilobyte bundle.
harvest_from_out() {
    if [ -s "$OUT/harvest_error.txt" ]; then
        echo "ffbox: the run refused to publish: $(cat "$OUT/harvest_error.txt")" >&2
        return 0
    fi
    if [ ! -s "$OUT/work.bundle" ]; then
        echo "[ffbox] no work bundle — no branch, no PR"
        rm -f "$OUT/branch.txt" "$OUT/publish_base.txt"
        return 0
    fi

    _hb=$(head -1 "$OUT/branch.txt" 2>/dev/null | tr -d ' \r\n')
    _hbase=$(head -1 "$OUT/publish_base_sha.txt" 2>/dev/null | tr -d ' \r\n')
    [ -n "$_hb" ] || { harvest_failed "the run left a bundle but no branch name"; return 0; }
    [ -n "$_hbase" ] || { harvest_failed "the run left a bundle but no publish base"; return 0; }

    # A protected branch is refused on the NAME the host would push to, before anything else.
    for _p in $PROTECTED_BRANCHES; do
        [ "$_hb" = "$_p" ] || continue
        harvest_failed "the run asks to publish as $_p, which this pipeline never pushes to"
        return 0
    done
    git check-ref-format --branch "$_hb" >/dev/null 2>&1 \
        || { harvest_failed "the run asks to publish as '$_hb', which is not a usable branch name"; return 0; }

    _bytes=$(wc -c < "$OUT/work.bundle" 2>/dev/null || echo 0)
    if [ "$_bytes" -gt "$MAX_BUNDLE_BYTES" ]; then
        harvest_failed "the work bundle is ${_bytes} bytes, over the ceiling of ${MAX_BUNDLE_BYTES}"
        return 0
    fi

    [ -d "$MIRROR_REPO_PATH" ] \
        || { harvest_failed "no mirror at $MIRROR_REPO_PATH to verify the bundle against"; return 0; }
    _scratch=$(mktemp -d "${TMPDIR:-/tmp}/ffbox-verify-XXXXXX") || {
        harvest_failed "could not make a scratch repo to verify the bundle"; return 0; }

    if ! git clone -q --no-checkout --local --shared "$MIRROR_REPO_PATH" "$_scratch" 2>/dev/null; then
        rm -rf "$_scratch"; harvest_failed "could not open the mirror to verify the bundle"; return 0
    fi
    # THE PREREQUISITE CHECK, and it is the load-bearing one: a bundle whose base the host does not
    # have is a range the host cannot push, and one whose base is not on the mirror is a range that
    # does not descend from anything real.
    if ! git -C "$_scratch" bundle verify "$OUT/work.bundle" >/dev/null 2>&1; then
        rm -rf "$_scratch"
        harvest_failed "the work bundle does not verify against the mirror"
        return 0
    fi
    if ! git -C "$_scratch" fetch -q "$OUT/work.bundle" '+refs/heads/*:refs/remotes/run/*' 2>/dev/null; then
        rm -rf "$_scratch"; harvest_failed "could not read the work bundle"; return 0
    fi

    _tip=$(git -C "$_scratch" rev-parse --verify --quiet "refs/remotes/run/$_hb" 2>/dev/null || echo "")
    if [ -z "$_tip" ]; then
        rm -rf "$_scratch"
        harvest_failed "the bundle carries no branch called $_hb"
        return 0
    fi
    if ! git -C "$_scratch" merge-base --is-ancestor "$_hbase" "$_tip" 2>/dev/null; then
        rm -rf "$_scratch"
        harvest_failed "the bundled work does not descend from the base it names ($_hbase)"
        return 0
    fi

    # Identity, out of the bundle rather than out of the container's word for it.
    _foreign=$(git -C "$_scratch" log --format='%ae%n%ce' "${_hbase}..${_tip}" 2>/dev/null \
               | sort -u | grep -Fxv "$FFBOX_GIT_EMAIL" || true)
    if [ -n "$_foreign" ]; then
        rm -rf "$_scratch"
        harvest_failed "commits claim an identity this run does not own: $(printf '%s' "$_foreign" | tr '\n' ' ')"
        return 0
    fi

    # Paths and ceilings, likewise re-derived. changed_files.txt is rewritten from the bundle so
    # that what the host reports and what it checked are the same list.
    # rm first, then write: the container created these and the host may not be able to truncate
    # them in place. A FAILURE HERE IS FATAL rather than ignored -- if the host cannot write its
    # own derivation it would go on to read the container's copy, which is exactly the word it is
    # supposed to be checking. Silently trusting the thing under test is worse than refusing.
    rm -f "$OUT/changed_files.txt" "$OUT/changes.patch"
    if ! git -C "$_scratch" diff --name-only "${_hbase}..${_tip}" > "$OUT/changed_files.txt" 2>/dev/null; then
        rm -rf "$_scratch"
        harvest_failed "could not write the host's own list of changed files; refusing to fall back on the run's"
        return 0
    fi
    _forbidden=$(grep -E "$FORBIDDEN_PATHS_RE" "$OUT/changed_files.txt" 2>/dev/null | tr '\n' ' ' || true)
    if [ -n "$_forbidden" ]; then
        rm -rf "$_scratch"
        harvest_failed "the range changes CI configuration, which this pipeline never publishes: $_forbidden"
        return 0
    fi
    _count=$(wc -l < "$OUT/changed_files.txt" 2>/dev/null || echo 0)
    if [ "$_count" -gt "$MAX_CHANGED_FILES" ]; then
        rm -rf "$_scratch"
        harvest_failed "$_count changed files, over the ceiling of ${MAX_CHANGED_FILES}"
        return 0
    fi
    if [ "$_count" -eq 0 ]; then
        rm -rf "$_scratch"
        rm -f "$OUT/work.bundle" "$OUT/branch.txt" "$OUT/changes.patch"
        echo "[ffbox] no file changes in this run — no branch, no bundle"
        return 0
    fi

    # The patch is regenerated here too, so a reviewer reads the same range the checks passed.
    git -C "$_scratch" diff --binary "${_hbase}..${_tip}" > "$OUT/changes.patch" 2>/dev/null || true
    _commits=$(git -C "$_scratch" rev-list --count "${_hbase}..${_tip}" 2>/dev/null || echo '?')
    rm -rf "$_scratch"
    echo "[ffbox] verified ${_count} changed file(s) in ${_commits} commit(s) on $_hb: $OUT/work.bundle"
    return 0
}

# --- harvest ---------------------------------------------------------------------------------------
# Do this before cleanup destroys the clone, or the work evaporates with it.

harvest_from_out

echo "[ffbox] results: $OUT"
exit "$RUN_RC"
