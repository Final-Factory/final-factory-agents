#!/usr/bin/env bash
#
# ffbox — hand a prompt to Claude, running one-shot inside a disposable Final Factory container.
#
# A plain prompt is an INGRESS: it is submitted to ffwatch as a turn, the same as a Discord
# message, and ffwatch launches this script again in executor mode to do the work. One pipeline,
# several front doors — so a shell run gets the same ceilings, kill switch, transcript index and
# web page as everything else. --direct opts out; --task/--job-file IS executor mode.
#
#   ffbox "make the belt merger respect item priority"
#   ffbox --keep --prompt-file ./task.md
#   ffbox --task ffbox/discord-task.sh --job-file job.json --run-id d7t2-1a2b   (ffwatch)
#
# Each run gets its own ZFS clone of the golden checkout, bind-mounted into a container built on
# the same Unity image CI uses. The clone is instant and costs ~0 bytes no matter how large the
# checkout is, and it inherits golden's warm Library/, so Unity does not re-import from cold.
# When the run ends, the changes are harvested as a patch and the clone is destroyed.
set -euo pipefail

# --- configuration (override via environment) ------------------------------------------------
# WHICH DAEMON, SET HERE RATHER THAN INHERITED. ffbox runs on the shared rootless daemon that
# ffbox-container owns, alongside the CI runners. Leaving this to the environment does not work:
# `docker` falls back to the CURRENT CONTEXT when DOCKER_HOST is unset, and this account's context
# is still `rootless` -> unix:///run/user/1015/docker.sock. The profile.d line only reaches a login
# shell, so anything non-interactive — a systemd unit, ffwatch, a script — silently used the old
# daemon. Measured on 2026-08-29: the run reached the old daemon, where the clone's owning uid
# 1020 is not in the map, and the container refused with "owned by a uid this daemon cannot map".
DOCKER_HOST=${DOCKER_HOST:-unix://${FFBOX_DOCKER_SOCK:-/run/ffbox-container/docker.sock}}
export DOCKER_HOST

IMAGE=${FFBOX_IMAGE:-ffbox:latest}
# THE WORKSPACE COMES FROM CI'S CACHE, NOT FROM GOLDEN. A run used to be a ZFS clone of
# /opt/FinalFactory, which meant golden had to exist, be current, and carry a warm Library that
# 04-warmLibrary.sh built for it. All three are gone: the tar CI already writes is a whole
# workspace including that Library, and the local git mirror supplies the commits since.
#
# /opt/FinalFactory stays on this box as a place to edit Final Factory by hand. Nothing here
# reads it any more.
# Named only so the "apply with" hint at the end can point somewhere useful. ffbox does not read
# this path any more; it stays on the box as a place to edit Final Factory by hand.
DEV_CHECKOUT=${FFBOX_DEV_CHECKOUT:-/opt/FinalFactory}
CACHE_DIR=${FFBOX_CACHE_DIR:-/opt/ffcache}
CACHE_ENTRIES=${FFBOX_CACHE_ENTRIES:-$CACHE_DIR/entries}
MIRROR_REPO_PATH=${FFBOX_MIRROR_REPO:-$CACHE_DIR/mirror/FinalFactory.git}
UNITY_SCOPE=${FFBOX_UNITY_SCOPE:-}
RUNS_MNT=${FFBOX_RUNS_MNT:-/opt/ffruns}
SECRETS=${FFBOX_SECRETS:-$HOME/.config/ffbox/secrets.env}
RESULTS=${FFBOX_RESULTS:-$HOME/ffbox-runs}

# The run's network. ffbox-net is a Docker --internal bridge: no default route, so no internet, no
# LAN, and no reaching this host either — under the rootless daemon the bridge lives inside the
# rootlesskit network namespace, so there is no path to the host to begin with and no firewall
# rule is involved. The single thing on it is the egress proxy at FFBOX_DNS, which resolves and connects
# only the names in ffbox/egress/allowlist.txt. Anything else the container tries is refused at
# the SNI and logged. See docs/docker-security-model.md.
#
# `--network bridge` opts out and restores the old unrestricted egress. That is a real choice an
# operator can make; it is not one an agent inside the container can make.
#
# UNFILTERED INCLUDES THIS HOST. Measured 2026-08-25: a container on the default bridge reached
# this machine's LAN address on port 22, under both daemons. Rootless disables the host
# LOOPBACK, not the host's own IP. So `--network bridge` is not "the fence minus DNS filtering",
# it is no fence.
NETWORK=${FFBOX_NETWORK:-ffbox-net}
DNS=${FFBOX_DNS:-10.80.0.2}
EGRESS_NAME=${FFBOX_EGRESS_NAME:-ffbox-egress}

KEEP=0
OUTPUT_FORMAT=text
PROMPT=
DIRECT=0
PROMPT_FILE=
REF=
BRANCH=
BRANCH_PREFIX=
BASE_REFS=
TASK=
JOB_FILE=
RUN_ID_OVERRIDE=
MOUNTS=()
# Golden is brought to origin before every clone (see "golden" below). This is the escape hatch
# for the two cases where that is wrong: reproducing a bug against exactly the code golden is
# already on, and running when origin is unreachable and you would rather have a stale run than
# no run.
SKIP_FETCH=${FFBOX_SKIP_FETCH:-0}

# The three clocks of the Discord design, section 8. They are ENFORCED only when this run is a
# task run (or when one of the flags is given explicitly): a plain interactive one-shot was
# always unbounded and quietly acquiring a one-hour ceiling would be a surprise.
AGENT_TIMEOUT=900        # agent working time, measured from the task's own start marker
WARMUP_TIMEOUT=3600      # clone, container start, Unity activation, Library delta
# Harness-owned verification (design section 14) is a fourth phase with a fourth marker. Without
# its own ceiling it would burn the AGENT clock, and a fix lane whose agent finished in fourteen
# minutes would then be killed mid-test-run and recorded as a hung agent — which is exactly the
# conflation the separate clocks exist to prevent.
VERIFY_TIMEOUT=1800
KILL_GRACE=10            # after SIGTERM is ignored, force
CLOCKS=0

usage() {
    sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'
    cat <<'EOF'

Options:
  --prompt-file FILE   Read the prompt from FILE instead of the command line.
  --direct             Do not route the prompt through ffwatch; clone and run right here.
                       Skips the database, the ceilings and the web page. For bootstrapping a
                       machine and for debugging the container itself.
  --keep               Leave the ZFS clone and its mountpoint in place for inspection.
                       Remove it yourself with: rm -rf <workspace>
  --no-fetch           Clone golden exactly as it is instead of bringing it to origin first.
                       Also FFBOX_SKIP_FETCH=1. Without this the run fails rather than
                       silently reasoning against a checkout of unknown age.
  --json               Emit Claude's stream-json output instead of plain text.
  --image NAME         Container image to run (default: ffbox:latest).
  --network NAME       Docker network for the run (default: ffbox-net, the filtered one). Use
                       "bridge" for unrestricted egress — it is the old behaviour, and it hands
                       whatever runs in there the whole internet and this machine's LAN.
  --ref REF            Check the workspace out at REF after cloning (a branch, tag or sha;
                       "develop" resolves to origin/develop when no local branch matches).
                       The resolved sha is written to <results>/base_sha.txt.
  --branch NAME        Create NAME at the checked-out commit before the container starts, and
                       harvest the run's work as a git bundle on it (<results>/work.bundle)
                       alongside the patch. Creating it is a ref move, so nothing churns under
                       the warm Library/. No changed files means no commit, no bundle and no
                       branch left behind.
  --base-refs "A B"    Branches the run's work may be based on, most-preferred first (the
                       harness passes "develop master"). At harvest the published range starts
                       at whichever of them the work actually descends from, so an agent that
                       branched off origin/master is bundled against master rather than refused
                       for not descending from the ref the run was checked out at. The name is
                       written to <results>/publish_base.txt, which is what the pull request
                       ends up targeting. Empty means the checked-out commit is the only base.
  --branch-prefix P    Let the agent name the published branch. When the run ends on a branch
                       it made itself, the bundle is harvested as P<that name>-<run id> instead
                       of NAME, so a reviewer reads "ffbox/belt-merger-priority-<id>" rather
                       than a run id. Without this the published name is always NAME. Either
                       way a run that ends on develop, master or main (FFBOX_PROTECTED_BRANCHES)
                       is refused and publishes nothing.
  --task PATH          Container task to run instead of the default one-shot. A host path is
                       mounted read-only at /ffbox/task.sh; anything else is taken as a path
                       already inside the image. Sets FFBOX_ENTRY.
  --job-file FILE      Mount FILE read-only at /ffbox/job.json for the task to read.
  --mount SPEC         Extra bind mount, HOST:CONTAINER[:ro]. Repeatable. Nested paths under
                       /workspace work; Docker creates the intermediate directories.
  --run-id ID          Use ID for the run instead of a timestamp, so the caller owns the
                       ffbox-<ID> container name and can address exactly it later.
  --agent-timeout N    Seconds of AGENT working time (default 900). The clock starts when the
                       task creates <out>/.agent-started, not when ffbox does.
  --warmup-timeout N   Seconds for everything before that marker (default 3600).
  --verify-timeout N   Seconds for the harness verification phase after the agent exits, from
                       <out>/.verify-started (default 1800). Its own clock, so a Unity test run
                       is never mistaken for a hung agent.
  --kill-grace N       Seconds between SIGTERM and force (default 10). Every run holds an
                       editor, so the stop allows at least 120s whatever this says — that is
                       the licence round trip, not the agent. Raise it past 120 to give a
                       stubborn agent longer; lowering it below cannot strand the seat.
  -h, --help           Show this help.

Timeout exit codes: 123 = warm-up ceiling exceeded, 124 = agent ceiling exceeded, 125 =
verification ceiling exceeded (the agent had already finished). Each also writes the word
"warmup", "agent" or "verify" to <results>/ffbox-timeout.

Secrets are read from an env file, never from the command line — anything in argv is visible
in /proc/<pid>/cmdline and lands in shell history. Default location:
  ~/.config/ffbox/secrets.env   (chmod 600; see secrets.env.example)
EOF
}

# --- argument parsing --------------------------------------------------------------------------
while [ $# -gt 0 ]; do
    case "$1" in
        --prompt-file)    PROMPT_FILE=${2:?--prompt-file needs a path}; shift 2 ;;
        --direct)         DIRECT=1; shift ;;
        --keep)           KEEP=1; shift ;;
        --no-fetch)       SKIP_FETCH=1; shift ;;
        --json)           OUTPUT_FORMAT=stream-json; shift ;;
        --image)          IMAGE=${2:?--image needs a name}; shift 2 ;;
        --network)        NETWORK=${2:?--network needs a name}; shift 2 ;;
        --ref)            REF=${2:?--ref needs a git ref}; shift 2 ;;
        --branch)         BRANCH=${2:?--branch needs a name}; shift 2 ;;
        --branch-prefix)  BRANCH_PREFIX=${2:?--branch-prefix needs a prefix}; shift 2 ;;
        --base-refs)      BASE_REFS=${2:?--base-refs needs a list}; shift 2 ;;
        --task)           TASK=${2:?--task needs a path}; CLOCKS=1; shift 2 ;;
        --job-file)       JOB_FILE=${2:?--job-file needs a path}; CLOCKS=1; shift 2 ;;
        --mount)          MOUNTS+=("${2:?--mount needs HOST:CONTAINER[:ro]}"); shift 2 ;;
        --run-id)         RUN_ID_OVERRIDE=${2:?--run-id needs an id}; shift 2 ;;
        --agent-timeout)  AGENT_TIMEOUT=${2:?--agent-timeout needs seconds}; CLOCKS=1; shift 2 ;;
        --warmup-timeout) WARMUP_TIMEOUT=${2:?--warmup-timeout needs seconds}; CLOCKS=1; shift 2 ;;
        --verify-timeout) VERIFY_TIMEOUT=${2:?--verify-timeout needs seconds}; CLOCKS=1; shift 2 ;;
        --kill-grace)     KILL_GRACE=${2:?--kill-grace needs seconds}; CLOCKS=1; shift 2 ;;
        -h|--help)        usage; exit 0 ;;
        --)               shift; break ;;
        -*)               echo "ffbox: unknown option $1" >&2; usage >&2; exit 2 ;;
        *)                break ;;
    esac
done

for spec in "${MOUNTS[@]}"; do
    case "$spec" in
        /*:/*) ;;
        *) echo "ffbox: --mount needs HOST:CONTAINER[:ro] with absolute paths, got '$spec'" >&2
           exit 2 ;;
    esac
done

if [ -n "$RUN_ID_OVERRIDE" ]; then
    # This becomes a container name, and it is the ONLY handle anything gets for destroying
    # this run's container later. Anything that would need quoting is rejected here rather
    # than producing a container nobody can address.
    case "$RUN_ID_OVERRIDE" in
        *[!A-Za-z0-9._-]*|"") echo "ffbox: --run-id must match [A-Za-z0-9._-]+" >&2; exit 2 ;;
    esac
fi

if [ -n "$BRANCH" ]; then
    # This name reaches `git checkout -B` and later `git push <remote> <branch>` on the host, so
    # anything git would treat as an option or a refspec separator is refused here rather than
    # becoming a surprising ref. Slashes are allowed because ffbox/<run-id> is the whole point.
    case "$BRANCH" in
        -*|*..*|*:*|*[!A-Za-z0-9._/-]*|"")
            echo "ffbox: --branch must match [A-Za-z0-9._/-]+ and not start with '-'" >&2
            exit 2 ;;
    esac
fi

if [ -n "$PROMPT_FILE" ]; then
    [ -r "$PROMPT_FILE" ] || { echo "ffbox: cannot read $PROMPT_FILE" >&2; exit 2; }
    PROMPT=$(cat "$PROMPT_FILE")
elif [ $# -gt 0 ]; then
    PROMPT="$*"
elif [ -z "$TASK" ] && [ ! -t 0 ]; then
    PROMPT=$(cat)
fi

# A task run carries its instructions in its own mounted files (job.json for the Discord lanes),
# so a prompt is required only for the default one-shot task.
if [ -z "$TASK" ] && [ -z "${PROMPT// }" ]; then
    echo "ffbox: no prompt given" >&2
    usage >&2
    exit 2
fi

# --- one pipeline, several front doors ------------------------------------------------------------
# A plain prompt is an INGRESS, not an execution: it goes to ffwatch as a turn, exactly as a
# Discord message does, and ffwatch launches this same script in executor mode (--task/--job-file)
# to do the work. That is what puts a shell run on the web page, under the same ceilings, kill
# switch, transcript index and recovery as everything else — one path by which Claude is invoked.
#
# Executor mode (--task or --job-file present) never routes: that IS the run ffwatch asked for,
# and routing it would recurse. --direct forces the old behaviour for bootstrapping and for
# debugging the container itself.
FFBOX_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
FFWATCH_PY=${FFWATCH_PY:-$FFBOX_DIR/ffwatch.py}
if [ "$DIRECT" = 0 ] && [ -z "$TASK" ] && [ -z "$JOB_FILE" ] && [ -r "$FFWATCH_PY" ]; then
    ROUTE=("python3" "$FFWATCH_PY" "submit" "--wait")
    [ -z "$REF" ] || ROUTE+=("--ref" "$REF")
    [ -z "$BRANCH" ] || ROUTE+=("--branch" "$BRANCH")
    ROUTE+=("$PROMPT")
    exec "${ROUTE[@]}"
fi

# --- secrets ------------------------------------------------------------------------------------
if [ -r "$SECRETS" ]; then
    perms=$(stat -c '%a' "$SECRETS")
    case "$perms" in
        600|400) ;;
        *) echo "ffbox: WARNING: $SECRETS is mode $perms; expected 600" >&2 ;;
    esac
    set -a
    # shellcheck disable=SC1090
    . "$SECRETS"
    set +a
else
    echo "ffbox: WARNING: no secrets file at $SECRETS" >&2
    echo "       Run 'sh ffbox/setup.sh' to create it from the template." >&2
fi

if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    echo "ffbox: CLAUDE_CODE_OAUTH_TOKEN is not set. Generate one with 'claude setup-token'" >&2
    echo "       and put it in $SECRETS — it bills against your subscription, not an API key." >&2
    exit 78
fi

# A Unity .ulf does not contain a usable license for the container: game-ci extracts the 27-char
# serial out of it and activates online with that. Replicate the decode here so the secrets file
# can hold either UNITY_SERIAL directly or a path to the .ulf.
if [ -z "${UNITY_SERIAL:-}" ] && [ -n "${UNITY_LICENSE_FILE:-}" ]; then
    if [ ! -r "$UNITY_LICENSE_FILE" ]; then
        echo "ffbox: cannot read UNITY_LICENSE_FILE=$UNITY_LICENSE_FILE" >&2
        exit 78
    fi
    # <DeveloperData Value="base64"/> — decode, then drop 4 leading garbage bytes.
    UNITY_SERIAL=$(sed -n 's/.*<DeveloperData Value="\([^"]*\)".*/\1/p' "$UNITY_LICENSE_FILE" \
                   | head -1 | base64 -d 2>/dev/null | cut -c5-)
    export UNITY_SERIAL
    if [ ${#UNITY_SERIAL} -ne 27 ]; then
        echo "ffbox: extracted a ${#UNITY_SERIAL}-char serial from $UNITY_LICENSE_FILE; expected 27" >&2
        exit 78
    fi
fi

# --- preflight ------------------------------------------------------------------------------------
command -v docker >/dev/null || { echo "ffbox: docker not found" >&2; exit 127; }
docker image inspect "$IMAGE" >/dev/null 2>&1 || {
    echo "ffbox: image '$IMAGE' not built. Run: ffbox/03-build.sh" >&2
    exit 69
}

# The filtered network fails CLOSED and says so here. A missing network or a stopped proxy is not
# something to fall back from: Docker would happily start the run on the default bridge with the
# whole internet available, and nothing downstream would ever mention it. Checked before the ZFS
# clone rather than after, so a misconfigured machine costs a second instead of a Unity import.
NETWORK_ARGS=(--network "$NETWORK")
case "$NETWORK" in
    bridge|host|none)
        echo "ffbox: WARNING: --network $NETWORK — this run has unfiltered network access," >&2
        echo "       including to this host itself" >&2
        ;;
    *)
        docker network inspect "$NETWORK" >/dev/null 2>&1 || {
            echo "ffbox: network '$NETWORK' does not exist." >&2
            echo "       Run: sh ffbox/egress/ffbox-egress.sh up" >&2
            echo "       Or, deliberately, run unfiltered with: --network bridge" >&2
            exit 69
        }
        if [ "$(docker inspect -f '{{.State.Running}}' "$EGRESS_NAME" 2>/dev/null)" != true ]; then
            echo "ffbox: the egress proxy '$EGRESS_NAME' is not running, so nothing on" >&2
            echo "       '$NETWORK' can resolve a name or reach the model." >&2
            echo "       Run: sh ffbox/egress/ffbox-egress.sh up" >&2
            exit 69
        fi
        NETWORK_ARGS+=(--dns "$DNS")
        ;;
esac

[ -d "$CACHE_ENTRIES" ] || {
    echo "ffbox: no workspace cache at $CACHE_ENTRIES" >&2
    echo "       CI fills it; provision it with ffbox/runners/01-hostSetup.sh" >&2
    exit 69; }

RUN_ID=${RUN_ID_OVERRIDE:-$(date +%Y%m%d-%H%M%S)-$$}
MNT="${RUNS_MNT}/run-${RUN_ID}"
OUT="${RESULTS}/${RUN_ID}"

mkdir -p "$OUT"

# THE OUTPUT MOUNT HAS TO BE REACHABLE BY THE CONTAINER'S ROOT, and on the shared daemon that is a
# different account. The container runs as namespace root, which maps to ffbox-container on the
# host; this directory belongs to the invoking user, whose uid is NOT in that daemon's map. It
# shows up inside as 65534, and capabilities in a user namespace do not extend to files owned by
# an unmapped uid — so even root WITH CAP_DAC_OVERRIDE is refused. Measured on 2026-08-29: caps
# a80425fb, DAC_OVERRIDE set, and `touch /ffbox/out/probe` still denied.
#
# The GROUP is the way through, and it needs no privilege: chgrp to a group we are already in.
# ffbox-container maps to gid 0 inside the container, so group-write is write. setgid so anything
# the run leaves behind keeps the group.
if getent group ffbox-container >/dev/null 2>&1; then
    chgrp ffbox-container "$OUT" 2>/dev/null && chmod 2775 "$OUT" 2>/dev/null || {
        echo "[ffbox] WARNING: could not give $OUT to the ffbox-container group;" >&2
        echo "[ffbox]          the container may not be able to write its output." >&2
    }
fi
if [ -n "${PROMPT// }" ]; then
    printf '%s' "$PROMPT" > "$OUT/prompt.txt"
fi

# --- extra mounts --------------------------------------------------------------------------------
DOCKER_MOUNTS=()
for spec in "${MOUNTS[@]}"; do
    host=${spec%%:*}
    if [ ! -e "$host" ]; then
        # Docker would create a missing host path as a ROOT-owned directory, which the
        # host-side caller then cannot write or clean up. Create it as ourselves instead.
        mkdir -p "$host"
    fi
    DOCKER_MOUNTS+=(-v "$spec")
done

ENTRY_ENV=()
if [ -n "$TASK" ]; then
    if [ -r "$TASK" ]; then
        TASK_ABS=$(cd "$(dirname "$TASK")" && pwd)/$(basename "$TASK")
        DOCKER_MOUNTS+=(-v "$TASK_ABS:/ffbox/task.sh:ro")
        ENTRY_ENV+=(-e "FFBOX_ENTRY=/ffbox/task.sh")
    else
        # Not a host file: assume it is a path that already exists inside the image.
        ENTRY_ENV+=(-e "FFBOX_ENTRY=$TASK")
    fi
fi
if [ -n "$JOB_FILE" ]; then
    [ -r "$JOB_FILE" ] || { echo "ffbox: cannot read $JOB_FILE" >&2; exit 2; }
    JOB_ABS=$(cd "$(dirname "$JOB_FILE")" && pwd)/$(basename "$JOB_FILE")
    DOCKER_MOUNTS+=(-v "$JOB_ABS:/ffbox/job.json:ro")
    ENTRY_ENV+=(-e "FFBOX_JOB_FILE=/ffbox/job.json")
fi

# --- lifecycle ---------------------------------------------------------------------------------
cleanup() {
    local rc=$?
    set +e

    # Stop rather than kill: SIGTERM reaches run-as-user.sh as PID 1 so it can hand the Unity
    # activation seat back before dying. A killed container leaks the seat.
    if docker ps -q --filter "name=ffbox-${RUN_ID}" | grep -q .; then
        echo "[ffbox] stopping container (allowing license return)..." >&2
        docker stop --timeout 120 "ffbox-${RUN_ID}" >/dev/null 2>&1
    fi

    if [ "$KEEP" = 1 ]; then
        echo "[ffbox] --keep: workspace left at $MNT" >&2
        echo "[ffbox]         remove it with: rm -rf $MNT" >&2
    else
        # A plain directory now, not a ZFS clone, so this needs no sudo at all. The narrow
        # NOPASSWD rules that existed for `zfs snapshot|clone|destroy` are dead with it and can
        # be dropped from sudoers.
        [ -n "${WS_MADE:-}" ] && rm -rf "$MNT" 2>/dev/null
    fi
    return $rc
}
trap cleanup EXIT INT TERM

# --- git identity and harvest ceilings -----------------------------------------------------------
# The agent commits its OWN work now (WRITE_ALLOWED in ffwatch.py grants local git), so the
# clone carries the identity those commits get and the harvest checks every commit against it.
# A commit claiming somebody else is how an agent would dress its work up as a human's, and it
# would reach a reviewer looking exactly like one.
FFBOX_GIT_NAME=${FFBOX_GIT_NAME:-ffbox}
FFBOX_GIT_EMAIL=${FFBOX_GIT_EMAIL:-ffbox@final-factory.invalid}

# Ceilings on what one run may publish. Not a security boundary — the agent could stay under
# either one — but a runaway `git add -A` over a re-imported Library/ is a mistake worth
# catching before it becomes a 40GB push.
MAX_CHANGED_FILES=${FFBOX_MAX_CHANGED_FILES:-2000}
# PATHS THIS PIPELINE NEVER PUBLISHES. A pushed branch is code execution on the build machine:
# FinalFactory's .github/workflows/main.yml is `on: [push, pull_request]` and `runs-on:
# self-hosted`, with the Unity account and GITHUB_TOKEN in scope, and GitHub runs the workflow
# AS IT EXISTS ON THE PUSHED BRANCH rather than the one on develop. So an agent that edits one
# has its own steps run with real secrets before a human reads the diff, and the verification
# gate cannot catch it: that gate asks whether the change compiles and passes tests, and a
# workflow payload does both while the code beside it is perfectly good.
FORBIDDEN_PATHS_RE=${FFBOX_FORBIDDEN_PATHS_RE:-^\.github/}
MAX_BUNDLE_BYTES=${FFBOX_MAX_BUNDLE_BYTES:-268435456}

# Branches a run may not END on. The agent is told to make its own branch and told what happens
# if it does not; this is the half that makes the telling true. Work committed onto develop or
# master is a change to the integration branch itself dressed up as a proposal — the range would
# still bundle and still push, and the reviewer would have no way to see which it was.
#
# It is deliberately about where HEAD ENDS UP, not about which commits exist. An agent that
# committed on develop and then branched off it publishes that work on the branch, which is the
# outcome everybody wants; what is refused is finishing the run on the shared branch.
PROTECTED_BRANCHES=${FFBOX_PROTECTED_BRANCHES:-develop master main}

# Splits `git status --porcelain -z` into two NUL-separated pathspec files: paths that exist in
# HEAD, and paths that do not. Called twice — once to clean the clone before the agent sees it,
# once at harvest as a backstop for whatever the clean could not reach.
#
# A rename carries a SECOND NUL-terminated field (the original path) which must be consumed or
# every later entry is read one field out of step.
split_status_z() {
    python3 - "$1" "$2" "$3" <<'PYBASE'
import sys

fields = open(sys.argv[1], "rb").read().split(b"\0")
tracked, untracked = [], []
i = 0
while i < len(fields):
    entry = fields[i]
    i += 1
    if len(entry) < 4:
        continue
    code, path = entry[:2], entry[3:]
    if b"R" in code or b"C" in code:
        # The original path of a rename/copy. It is tracked in HEAD, and it has to be consumed
        # here or every following entry is read one field out of step.
        if i < len(fields):
            tracked.append(fields[i])
            i += 1
    (untracked if code == b"??" else tracked).append(path)
open(sys.argv[2], "wb").write(b"\0".join(tracked) + (b"\0" if tracked else b""))
open(sys.argv[3], "wb").write(b"\0".join(untracked) + (b"\0" if untracked else b""))
PYBASE
}

# WHICH BRANCH THIS WORK IS FOR, decided by where it actually sits in the history rather than by
# anything the agent says about it. A fix for the released build is based on origin/master and a
# change for the next version on origin/develop; the agent chooses by choosing what it branches
# from, and this reads that choice back out of the commit graph.
#
# The rule is: among the candidate bases that are ANCESTORS of the work, take the one furthest
# down the history — the most specific. A branch off develop has both develop and master behind
# it (master is merged into develop), and develop is the descendant of the two, so develop wins.
# A branch off master has only master behind it, because develop carries commits the branch does
# not. Ties keep the earlier candidate, which is why the harness passes develop first.
#
# Ancestry is required, not merely preferred: the published range is base..work and the host
# pushes it as a fast-forward. A branch that descends from nothing we know about is a range
# nobody can describe, which is the same refusal an agent that reset below its base gets.
#
# Prints "<name> <sha>", or nothing at all when no candidate qualifies.
resolve_publish_base() {
    _tip=$1
    _best_name= _best_sha=
    for _name in $BASE_REFS; do
        _sha=$(git -C "$MNT" rev-parse --verify --quiet "origin/${_name}^{commit}" 2>/dev/null) \
            || _sha=$(git -C "$MNT" rev-parse --verify --quiet "${_name}^{commit}" 2>/dev/null) \
            || continue
        [ -n "$_sha" ] || continue
        git -C "$MNT" merge-base --is-ancestor "$_sha" "$_tip" 2>/dev/null || continue
        if [ -z "$_best_sha" ]; then
            _best_name=$_name _best_sha=$_sha
        elif [ "$_best_sha" != "$_sha" ] \
             && git -C "$MNT" merge-base --is-ancestor "$_best_sha" "$_sha" 2>/dev/null; then
            _best_name=$_name _best_sha=$_sha
        fi
    done
    [ -z "$_best_sha" ] || printf '%s %s\n' "$_best_name" "$_best_sha"
}

# Refuse to publish, and say why in a file ffwatch reads back as the run's no_branch_reason.
# Without this the host cannot tell "the harvest broke" from "the run changed nothing", and
# those two want very different replies.
harvest_failed() {
    printf '%s\n' "$1" > "$OUT/harvest_error.txt"
    rm -f "$OUT/work.bundle" "$OUT/branch.txt" "$OUT/publish_base.txt"
    echo "ffbox: harvest refused: $1" >&2
}

echo "[ffbox] run $RUN_ID"

# --- workspace: CI's cache tar, then the commits since, from the local mirror -----------------
#
# WHAT THIS REPLACED. A run used to be a ZFS clone of golden: flock, update-golden.sh, zfs
# snapshot, zfs clone. That needed /opt/FinalFactory to exist, to be current, and to carry a warm
# Library that 04-warmLibrary.sh built by opening the project in Unity every five minutes. All of
# it is gone. CI already writes a tar of a whole finished workspace -- worktree, .git and that
# same Library -- and the local git mirror has the commits since.
#
# THE COST, MEASURED, because it is not free: extracting a 15 GB entry takes about 220 seconds
# against a near-instant copy-on-write clone. That is the price of not depending on golden, and it
# is disk bandwidth rather than anything cleverness fixes -- ZFS block cloning would give it back
# but the pool has that feature disabled. A run's warmup budget is an hour, so it fits.
#
# NO SUDO, and that is a real reduction rather than a side effect: with no snapshot and no clone,
# the narrow NOPASSWD rules for zfs snapshot/clone/destroy have nothing left to authorise.
#
# THE AGENT ONLY EVER READS THE CACHE. Extraction happens here, on the host, from a directory the
# container never sees; the run cannot write back into an entry that later runs restore from.
mkdir -p "$MNT" || { echo "ffbox: could not create $MNT" >&2; exit 69; }
WS_MADE=1

# setgid + group-write, and this is load-bearing. The container runs as namespace root, which is
# host uid 1020 (ffbox-container); files written here as this account show up in there as an
# unmapped 65534, so ONLY the group bit makes the workspace writable. Host gid 1020 maps to gid 0
# inside, so group-write is root-write there. Verified before relying on it: without g+w the
# container can read the tree and change nothing in it.
if getent group ffbox-container >/dev/null 2>&1; then
    chgrp ffbox-container "$MNT" 2>/dev/null || true
    chmod 2775 "$MNT" 2>/dev/null || true
fi

# Which entry. The branch asked for, then the default branch, then whatever ran most recently at
# this editor version -- the same ladder main.yml's restore uses, so both modes agree on what a
# usable entry is.
[ -n "$UNITY_SCOPE" ] || UNITY_SCOPE=$(
    git -C "$MIRROR_REPO_PATH" show "refs/heads/master:ProjectSettings/ProjectVersion.txt" 2>/dev/null \
      | sed -n 's/^m_EditorVersion: *//p' | tr -d ' \r')
ENTRY=
_want_branch=${REF:-master}
_safe_branch=$(printf '%s' "$_want_branch" | sed 's|^origin/||; s/[^a-zA-Z0-9._-]/-/g')
for _cand in "$_safe_branch" master; do
    [ -n "$_cand" ] || continue
    if [ -f "$CACHE_ENTRIES/$_cand@$UNITY_SCOPE.tar" ]; then
        ENTRY="$CACHE_ENTRIES/$_cand@$UNITY_SCOPE.tar"; break
    fi
done
[ -n "$ENTRY" ] || ENTRY=$(find "$CACHE_ENTRIES" -maxdepth 1 -type f -name '*.tar' -printf '%T@ %p\n' 2>/dev/null \
                            | sort -rn | head -1 | cut -d' ' -f2-)
[ -n "$ENTRY" ] || {
    echo "ffbox: no usable cache entry in $CACHE_ENTRIES" >&2
    echo "       one CI job on master creates one." >&2
    exit 69; }

echo "[ffbox] restoring $(basename "$ENTRY") ($(du -h "$ENTRY" 2>/dev/null | cut -f1)) into $MNT"
_t0=$(date +%s)
tar -xf "$ENTRY" -C "$MNT" --no-same-owner --no-same-permissions || {
    echo "ffbox: could not extract $ENTRY" >&2; exit 69; }
# The archive's modes are the CI container's, so nothing is group-writable until this runs.
chmod -R g+w "$MNT" 2>/dev/null || true
echo "[ffbox] restored in $(( $(date +%s) - _t0 ))s"

[ -d "$MNT/.git" ] || { echo "ffbox: the cache entry has no .git; refusing to run" >&2; exit 69; }

# --- bring it to the tip, from the mirror ------------------------------------------------------
# The mirror is a local path here, so this is a file copy of a few objects rather than a network
# fetch, and it needs no credential. Fetching every head into origin/* leaves the --ref resolution
# below exactly as it was when this was a golden clone.
if [ "$SKIP_FETCH" = 1 ]; then
    echo "[ffbox] --no-fetch: using the cache entry as it stands" >&2
elif [ -d "$MIRROR_REPO_PATH" ]; then
    git -C "$MNT" fetch --quiet --prune "$MIRROR_REPO_PATH" '+refs/heads/*:refs/remotes/origin/*' 2>/dev/null || {
        echo "ffbox: could not fetch from the mirror at $MIRROR_REPO_PATH" >&2
        echo "       Fix it, or pass --no-fetch to run against the cache entry as it stands." >&2
        exit 69; }
else
    echo "ffbox: no git mirror at $MIRROR_REPO_PATH" >&2
    echo "       Provision it with ffbox/runners/03-image.sh, or pass --no-fetch." >&2
    exit 69
fi

# Golden tracked master, so a run with no --ref used to land on master. Keep that.
[ -n "$REF" ] || REF=master

echo "[ffbox] workspace: $MNT (from $(basename "$ENTRY"))"

# A ZFS CLONE IS A DIFFERENT DATASET, SO EVERY FILE'S st_dev CHANGES. Git records dev and inode
# in the index, so the first `git status` in a clone disagrees with the index about all 26,677
# tracked files and re-hashes the entire worktree. Measured on a real clone of golden on
# 2026-08-31: 5.7s cold against 0.084s warm, from the host with the page cache already hot —
# in the container, cold, with the LFS filters attached, it is the dominant cost of answering a
# question that changed nothing.
#
# core.checkStat=minimal compares size and mtime and ignores dev/inode/ctime, which is exactly
# the set a clone perturbs and none of the set that tells us a file really changed. This is the
# same finding ffcache recorded for the tar path (design/ffcache_tasks.md: 124 of 130 seconds,
# 0.05s with the flag); the ZFS path reaches it by a different route and never got the fix.
#
# Written into the clone's own config, which the container's git reads. sanitize_clone_git()
# rewrites this file from scratch before the HOST runs git in it, and sets the same key there.
git -C "$MNT" config core.checkStat minimal 2>/dev/null || true
git -C "$MNT" config core.untrackedCache true 2>/dev/null || true

# HOST-SIDE GIT NEEDS PERMISSION TO LOOK AT A TREE IT DOES NOT OWN. Golden and its clones belong
# to ffbox-container so that a container on the shared daemon sees them as root; git, running here
# as the owner, then refuses with "detected dubious ownership" and every git call in the harvest
# fails with it.
#
# Passed through the environment rather than written to ~/.gitconfig: it applies to every git in
# this process tree and to nothing else, it names the exact two directories rather than `*`, and
# it leaves no state behind if this run is killed.
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0=safe.directory;   GIT_CONFIG_VALUE_0=$MNT
export GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0

# --- base ref ------------------------------------------------------------------------------------
# Golden tracks master; the Discord lanes want develop. Checking out in the clone costs a ref
# move plus a working-tree update, and Library/ stays warm because the import cache is keyed on
# content, not on which branch produced it.
if [ -d "$MNT/.git" ]; then
    if [ -n "$REF" ]; then
        TARGET=
        if git -C "$MNT" rev-parse --verify --quiet "${REF}^{commit}" >/dev/null 2>&1; then
            TARGET=$REF
        elif git -C "$MNT" rev-parse --verify --quiet "origin/${REF}^{commit}" >/dev/null 2>&1; then
            TARGET=origin/$REF
        fi
        if [ -z "$TARGET" ]; then
            echo "ffbox: --ref '$REF' resolves to nothing in the clone" >&2
            exit 69
        fi
        echo "[ffbox] checking out $TARGET"
        git -C "$MNT" checkout --detach --quiet "$TARGET" || {
            echo "ffbox: checkout of $TARGET failed" >&2; exit 69; }
    fi
    # Recorded whether or not --ref was given: the harvest step and ffwatch's base pinning both
    # need to know exactly which commit this run reasoned against.
    git -C "$MNT" rev-parse HEAD > "$OUT/base_sha.txt" 2>/dev/null || rm -f "$OUT/base_sha.txt"

    # Read now, while the clone is still exactly what golden was and no container has run. This is
    # the one value sanitize_clone_git needs to rebuild a config from, and taking it here rather
    # than afterwards is the difference between a known-good value and one the run chose.
    TRUSTED_ORIGIN_URL=$(git -C "$MNT" config --local --get remote.origin.url 2>/dev/null || echo "")

    # The work branch, created at the pinned base sha. `checkout -B` on the commit HEAD already
    # points at is a pure ref move: no file in the working tree is touched, so Library/ stays
    # warm and Unity has nothing to re-import (design section 17).
    if [ -n "$BRANCH" ]; then
        echo "[ffbox] work branch $BRANCH at $(cat "$OUT/base_sha.txt" 2>/dev/null)"
        git -C "$MNT" checkout -B "$BRANCH" --quiet || {
            echo "ffbox: could not create branch $BRANCH" >&2; exit 69; }
    fi

    # The identity the agent's commits get. Set in the clone rather than passed per-invocation,
    # because the agent runs `git commit` itself and would otherwise be stopped by git asking
    # who it is. The harvest checks the range against this address.
    # Not fatal under `set -e`: if this fails the agent cannot commit, but the harvest passes the
    # identity explicitly on its own commit, so the run still produces work. Aborting here would
    # throw away a whole container start over a config write.
    git -C "$MNT" config user.name "$FFBOX_GIT_NAME" || \
        echo "ffbox: WARNING: could not set the commit identity; the agent cannot commit" >&2
    git -C "$MNT" config user.email "$FFBOX_GIT_EMAIL" || true

    # THE CLONE MUST BE CLEAN BEFORE THE AGENT SEES IT, for two reasons that used to be one.
    # The old one: harvest does `git add -A`, so anything inherited from golden would be
    # committed onto the work branch as if the agent had done it, and "no changed files means
    # no branch and no PR" would never fire. The new one, and the reason subtracting at harvest
    # is no longer enough: the agent commits its own work now, so inherited dirt lands inside
    # ITS commits, where the harvest can no longer take it back out. It would also poison every
    # `git status` the agent reads while deciding what it has changed.
    #
    # Golden itself is clean. It stops being clean the moment --ref checks out a tree whose
    # .gitattributes differs from golden's: LFS patterns were lowercase-only until 2abbcc945
    # (2026-08-22, master), and git matches attribute patterns case-sensitively on Linux and
    # case-insensitively on Windows. On a ref without that commit, every `.PNG`/`.JPG`/`.TGA`/
    # `.PSD`/`.OBJ` committed from a Windows machine reads as modified against its pointer blob
    # — 247 files, ~52MB, when this was found.
    git -C "$MNT" status --porcelain -z > "$OUT/base_dirty.z" 2>/dev/null || : > "$OUT/base_dirty.z"
    if [ -s "$OUT/base_dirty.z" ]; then
        echo "[ffbox] baseline: $(tr -d -c '\0' < "$OUT/base_dirty.z" | wc -c) path(s) dirty" \
             "before the run; restoring them so the agent starts clean"
        split_status_z "$OUT/base_dirty.z" "$OUT/base_tracked.z" "$OUT/base_untracked.z" \
            || { : > "$OUT/base_tracked.z"; : > "$OUT/base_untracked.z"; }
        if [ -s "$OUT/base_tracked.z" ]; then
            git -C "$MNT" restore --source=HEAD --staged --worktree \
                --pathspec-from-file="$OUT/base_tracked.z" --pathspec-file-nul 2>/dev/null || true
        fi
        if [ -s "$OUT/base_untracked.z" ]; then
            # Untracked at baseline, so deleting them loses nothing that git is tracking, and
            # the clone is destroyed at the end of the run either way. Ignored paths are not in
            # this list at all — `git status --porcelain` does not report them — so Library/
            # survives and Unity has nothing to re-import.
            python3 - "$OUT/base_untracked.z" "$MNT" <<'PYCLEAN' || true
import os, shutil, sys

root = sys.argv[2].encode()
for path in open(sys.argv[1], "rb").read().split(b"\0"):
    if not path:
        continue
    target = os.path.join(root, path.rstrip(b"/"))
    try:
        shutil.rmtree(target) if os.path.isdir(target) else os.remove(target)
    except OSError:
        pass
PYCLEAN
        fi
        # Re-record. Whatever is STILL dirty is what the harvest has to subtract, and using the
        # pre-restore list there would be wrong: those paths are clean now, so subtracting them
        # would throw away the agent's work if it edited one of them.
        git -C "$MNT" status --porcelain -z > "$OUT/base_dirty.z" 2>/dev/null \
            || : > "$OUT/base_dirty.z"
        if [ -s "$OUT/base_dirty.z" ]; then
            echo "ffbox: WARNING: $(tr -d -c '\0' < "$OUT/base_dirty.z" | wc -c) path(s) still" \
                 "dirty after the restore; the harvest will exclude them" >&2
        else
            echo "[ffbox] baseline restored; the clone is clean"
        fi
    fi
fi

# --- run -----------------------------------------------------------------------------------------
# Secrets go in as environment variables read from the host-side env file. They are never baked
# into the image and never appear in argv.
PROMPT_MOUNT=()
if [ -f "$OUT/prompt.txt" ]; then
    PROMPT_MOUNT=(-v "$OUT/prompt.txt:/ffbox/prompt.txt:ro")
fi

set +e
docker run --rm \
    --name "ffbox-${RUN_ID}" \
    --hostname ffbox \
    "${NETWORK_ARGS[@]}" \
    -v "$MNT:/workspace" \
    -v "$OUT:/ffbox/out" \
    "${PROMPT_MOUNT[@]}" \
    "${DOCKER_MOUNTS[@]}" \
    "${ENTRY_ENV[@]}" \
    -e CLAUDE_CODE_OAUTH_TOKEN \
    -e UNITY_SERIAL -e UNITY_EMAIL -e UNITY_PASSWORD \
    -e CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    -e DISABLE_AUTOUPDATER=1 \
    -e FFBOX_OUTPUT_FORMAT="$OUTPUT_FORMAT" \
    "$IMAGE" &
DOCKER_PID=$!

TIMEOUT_KIND=
if [ "$CLOCKS" = 1 ]; then
    # Two clocks, watched from out here because only the host can tell the difference between
    # "Unity is still importing" and "the agent has hung". The task marks the handover by
    # creating .agent-started in the shared out directory.
    STARTED_AT=$(date +%s)
    while kill -0 "$DOCKER_PID" 2>/dev/null; do
        sleep 2
        NOW=$(date +%s)
        # Newest marker wins: the task creates .agent-started when the model starts and
        # .verify-started when the harness's own Unity run starts, so the phase in flight is the
        # one with the latest marker and each phase is judged against its own ceiling.
        if [ -f "$OUT/.verify-started" ]; then
            MARK=$(stat -c %Y "$OUT/.verify-started" 2>/dev/null || echo "$NOW")
            if [ "$VERIFY_TIMEOUT" -gt 0 ] && [ $((NOW - MARK)) -gt "$VERIFY_TIMEOUT" ]; then
                TIMEOUT_KIND=verify
                break
            fi
        elif [ -f "$OUT/.agent-started" ]; then
            MARK=$(stat -c %Y "$OUT/.agent-started" 2>/dev/null || echo "$NOW")
            if [ "$AGENT_TIMEOUT" -gt 0 ] && [ $((NOW - MARK)) -gt "$AGENT_TIMEOUT" ]; then
                TIMEOUT_KIND=agent
                break
            fi
        elif [ "$WARMUP_TIMEOUT" -gt 0 ] && [ $((NOW - STARTED_AT)) -gt "$WARMUP_TIMEOUT" ]; then
            TIMEOUT_KIND=warmup
            break
        fi
    done
    if [ -n "$TIMEOUT_KIND" ]; then
        # Never `docker kill`: the task is PID 1 and its trap is what returns the Unity seat.
        # Every run holds an editor now, so 120s is a FLOOR rather than a special case: that is
        # the licence round trip, and kill_grace is about an agent ignoring SIGTERM. Whichever
        # is larger wins, so an operator who asked for a longer grace still gets it.
        STOP_TIMEOUT=$KILL_GRACE
        [ "$STOP_TIMEOUT" -ge 120 ] || STOP_TIMEOUT=120
        echo "[ffbox] $TIMEOUT_KIND ceiling exceeded — stopping ffbox-${RUN_ID}" >&2
        printf '%s\n' "$TIMEOUT_KIND" > "$OUT/ffbox-timeout"
        docker stop --timeout "$STOP_TIMEOUT" "ffbox-${RUN_ID}" >/dev/null 2>&1
    fi
fi

wait "$DOCKER_PID"
RUN_RC=$?
set -e

case "$TIMEOUT_KIND" in
    warmup) RUN_RC=123 ;;
    agent)  RUN_RC=124 ;;
    verify) RUN_RC=125 ;;
esac

# --- harvest ---------------------------------------------------------------------------------------
# Do this before cleanup destroys the clone, or the work evaporates with it.

# THE CONTAINER HAS WRITTEN THIS TREE AND THE HOST IS ABOUT TO RUN git IN IT. That is finding F7
# in docs/ci-runner-security-findings.md, and it needs no vulnerability to exploit: git executes
# what .git tells it to. .git/hooks/post-commit, post-checkout and pre-push all run on ordinary
# commands, and .git/config names commands too — core.fsmonitor fires on `status`, plus core.pager,
# diff.external and filter.*.clean. `--no-verify` on the harvest commit suppresses pre-commit and
# commit-msg and none of the rest. FORBIDDEN_PATHS_RE does not help either: it is checked against
# the commit range, and neither .git/hooks nor .git/config is ever part of a commit.
#
# So the host does not read either of them. Both are replaced with known-good content first.
#
# A WHITELIST, NOT A BLACKLIST, and that is the whole point. Filtering dangerous keys out of the
# run's config means keeping a list of every key git can execute and adding to it forever. Writing
# the config from scratch means the run cannot define ANY key, including ones nobody has thought
# of. The only value carried across is the origin URL, captured before the container started.
#
# Replacing the config is safe here specifically because git-lfs is configured in the SYSTEM
# config on this box, not per-repository — verified: filter.lfs.clean/smudge/process/required all
# come from `git config --system`. If that ever changes, `git add` would start storing LFS payloads
# instead of pointers, so check it before assuming this still holds.
sanitize_clone_git() {
    [ -d "$MNT/.git" ] || return 0

    # Hooks: keep them for inspection, but out of the path git looks in.
    if [ -d "$MNT/.git/hooks" ]; then
        rm -rf "$MNT/.git/hooks.quarantined" 2>/dev/null || true
        mv "$MNT/.git/hooks" "$MNT/.git/hooks.quarantined" 2>/dev/null || true
    fi
    mkdir -p "$MNT/.git/hooks"

    if [ -f "$MNT/.git/config" ]; then
        mv "$MNT/.git/config" "$MNT/.git/config.quarantined" 2>/dev/null || true
    fi
    {
        printf '[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n'
        printf '\tbare = false\n\tlogallrefupdates = true\n'
        # The harvest's own git runs against a clone whose st_dev differs from golden's, so it
        # pays the same full re-hash the container just paid. Neither key names a command, so
        # both are safe in a config written from scratch — that is what the whitelist is for.
        printf '\tcheckStat = minimal\n\tuntrackedCache = true\n'
        if [ -n "${TRUSTED_ORIGIN_URL:-}" ]; then
            printf '[remote "origin"]\n\turl = %s\n' "$TRUSTED_ORIGIN_URL"
            printf '\tfetch = +refs/heads/*:refs/remotes/origin/*\n'
        fi
    } > "$MNT/.git/config"

    if ! cmp -s "$MNT/.git/config" "$MNT/.git/config.quarantined" 2>/dev/null; then
        echo "[ffbox] sanitized the clone's .git before touching it (F7)"
    fi
}
sanitize_clone_git

if [ -d "$MNT/.git" ]; then
    git -C "$MNT" status --porcelain > "$OUT/status.txt" 2>/dev/null || true

    if [ -n "$BRANCH" ]; then
        # The agent commits its own work now, so this is no longer "the harness makes the one
        # commit". What the harness still owns is the PUBLISHED RANGE: it commits whatever was
        # left uncommitted, points $BRANCH at wherever the agent ended, and refuses to bundle a
        # range that fails any check below. A lane that "forgot to commit" still cannot exist.
        BASE_SHA=$(cat "$OUT/base_sha.txt" 2>/dev/null || echo "")
        # WHICH BRANCH THIS WORK IS FOR. Read off HEAD, before anything below moves a ref:
        # adding a commit on top cannot change which published branch the work descends from,
        # and resolving it here means the leftover commit's own message is chosen against the
        # right base.
        rm -f "$OUT/publish_base.txt"
        PUBLISH_BASE= PUBLISH_BASE_SHA=
        if [ -n "$BASE_REFS" ]; then
            RESOLVED=$(resolve_publish_base HEAD)
            if [ -n "$RESOLVED" ]; then
                PUBLISH_BASE=${RESOLVED%% *}
                PUBLISH_BASE_SHA=${RESOLVED##* }
                echo "[ffbox] this work is based on $PUBLISH_BASE" \
                     "($(printf %.12s "$PUBLISH_BASE_SHA"))"
            fi
        fi
        if [ -z "$PUBLISH_BASE_SHA" ] && [ -n "$BASE_SHA" ] \
           && git -C "$MNT" merge-base --is-ancestor "$BASE_SHA" HEAD 2>/dev/null; then
            # No named branch claims it, but it still descends from the commit this run started
            # at — an ordinary run on a conversation pinned to a sha origin has moved past.
            # Publishable; the host targets its own default branch.
            PUBLISH_BASE_SHA=$BASE_SHA
        fi
        git -C "$MNT" add -A -- . ':(exclude).github' 2>/dev/null || true
        # Backstop for a baseline the pre-run restore could not clean. It only ever reaches what
        # is still UNCOMMITTED; anything the agent committed is past saving here, which is why
        # the restore moved to before the run. Tracked paths go back to their HEAD state; paths
        # that were untracked at baseline leave the index entirely. Both are pathspec-driven and
        # NUL-separated, because Final Factory has asset paths with spaces in them.
        if [ -s "$OUT/base_dirty.z" ]; then
            split_status_z "$OUT/base_dirty.z" "$OUT/base_tracked.z" "$OUT/base_untracked.z" \
                || { : > "$OUT/base_tracked.z"; : > "$OUT/base_untracked.z"; }
            if [ -s "$OUT/base_tracked.z" ]; then
                git -C "$MNT" restore --staged --source=HEAD \
                    --pathspec-from-file="$OUT/base_tracked.z" --pathspec-file-nul \
                    2>/dev/null || true
            fi
            if [ -s "$OUT/base_untracked.z" ]; then
                git -C "$MNT" rm --cached --quiet --ignore-unmatch \
                    --pathspec-from-file="$OUT/base_untracked.z" --pathspec-file-nul \
                    2>/dev/null || true
            fi
        fi
        if ! git -C "$MNT" diff --cached --quiet 2>/dev/null; then
            # Named for what it is. When the agent committed nothing this IS the work; when it
            # committed as it went, this is the tail it left behind, and calling both "agent
            # work" would make a reviewer read the second as the whole change.
            if [ "$(git -C "$MNT" rev-list --count "${PUBLISH_BASE_SHA}..HEAD" \
                    2>/dev/null || echo 0)" = "0" ]; then
                LEFTOVER_MSG="ffbox ${RUN_ID}: agent work"
            else
                LEFTOVER_MSG="ffbox ${RUN_ID}: uncommitted work at exit"
            fi
            # The identity is already in the clone's config, for the agent's sake. Passing it
            # again here is not redundant: if that config write failed, git refuses to commit
            # at all, and the harness's own commit is the one that must never be the thing that
            # silently drops a run's work.
            git -C "$MNT" \
                -c user.name="$FFBOX_GIT_NAME" -c user.email="$FFBOX_GIT_EMAIL" \
                commit --quiet --no-verify -m "$LEFTOVER_MSG" 2>/dev/null || true
        fi

        # --- what the harness will not publish ---------------------------------------------
        # None of these is a security boundary; the container is contained by holding no
        # credential. They catch the ways a range can stop meaning what the host assumes it
        # means once the agent, rather than the harness, decides what a commit is.
        HARVEST_OK=1

        # WHERE HEAD ENDS UP IS WHAT PUBLISHES. The agent may branch and switch freely while it
        # works, so the published branch follows HEAD rather than the other way round: a run
        # that did its work on a side branch and never switched back still publishes it, which
        # beats publishing the empty branch it started on and calling that the answer.
        CURRENT_BRANCH=$(git -C "$MNT" symbolic-ref --short -q HEAD 2>/dev/null || echo "")
        for protected in $PROTECTED_BRANCHES; do
            [ "$CURRENT_BRANCH" = "$protected" ] || continue
            harvest_failed "the run ended on $protected instead of on a branch of its own"
            HARVEST_OK=0
            break
        done

        # The agent's own name for the work, which is the one a reviewer ends up reading.
        # Sanitised rather than trusted: it reaches `git branch` here, a ref inside the bundle,
        # and a `git push` refspec on the host. The run id goes on the end unconditionally —
        # two runs at the same bug pick the same obvious name more often than you would think,
        # and a name that already exists on origin is a rejected push at the end of an hour's
        # work. Without --branch-prefix nothing is renamed and the host's name publishes, which
        # is what `ffbox --branch wip` has always meant.
        if [ "$HARVEST_OK" = 1 ] && [ -n "$BRANCH_PREFIX" ] && [ -n "$CURRENT_BRANCH" ] \
           && [ "$CURRENT_BRANCH" != "$BRANCH" ]; then
            AGENT_NAME=$(printf '%s' "${CURRENT_BRANCH#"$BRANCH_PREFIX"}" \
                         | tr -c 'A-Za-z0-9._/-' '-' \
                         | sed -e 's|//*|/|g' -e 's/--*/-/g' | cut -c1-80 \
                         | sed -e 's|^[-./]*||' -e 's|[-./]*$||')
            RENAMED="${BRANCH_PREFIX}${AGENT_NAME}-${RUN_ID}"
            if [ -n "$AGENT_NAME" ] \
               && git -C "$MNT" check-ref-format --branch "$RENAMED" >/dev/null 2>&1; then
                echo "[ffbox] the agent worked on $CURRENT_BRANCH; publishing it as $RENAMED"
                BRANCH=$RENAMED
            else
                echo "ffbox: WARNING: '$CURRENT_BRANCH' does not make a usable branch name;" \
                     "publishing as $BRANCH instead" >&2
            fi
        fi

        if [ "$HARVEST_OK" = 1 ] && [ "$CURRENT_BRANCH" != "$BRANCH" ]; then
            echo "[ffbox] run ended on ${CURRENT_BRANCH:-a detached HEAD}; pointing $BRANCH at it"
            git -C "$MNT" branch -f "$BRANCH" HEAD >/dev/null 2>&1 || {
                harvest_failed "the run's work could not be named $BRANCH"
                HARVEST_OK=0
            }
        fi

        # Everything below is defined in terms of base..branch, and the base is the one resolved
        # above: the published branch this work descends from, or failing that the commit the
        # run started at. Without one there is no range to bundle and no prerequisite for the
        # host's `git bundle verify` — which is precisely what an agent that reset or amended
        # below every base it could have had leaves behind.
        if [ "$HARVEST_OK" = 1 ] && [ -z "$PUBLISH_BASE_SHA" ]; then
            harvest_failed "the work descends neither from ${BASE_REFS:-any known branch} nor from the commit this run started at (${BASE_SHA:-none recorded}), so it cannot be bundled"
            HARVEST_OK=0
        fi
        # Every commit must be this run's own. `git merge`, `git rebase` and `git cherry-pick`
        # are deliberately absent from WRITE_ALLOWED, so there is no legitimate way for a commit
        # by somebody else to appear in this range: what would put one there is an agent running
        # `git -c user.email=... commit` to make its work look like a person's, on a branch a
        # reviewer reads by author.
        if [ "$HARVEST_OK" = 1 ]; then
            FOREIGN=$(git -C "$MNT" log --format='%ae%n%ce' "${PUBLISH_BASE_SHA}..${BRANCH}" 2>/dev/null \
                      | sort -u | grep -Fxv "$FFBOX_GIT_EMAIL" || true)
            if [ -n "$FOREIGN" ]; then
                FOREIGN_ONE_LINE=$(printf '%s' "$FOREIGN" | tr '\n' ' ')
                harvest_failed "commits claim an identity this run does not own: $FOREIGN_ONE_LINE"
                HARVEST_OK=0
            fi
        fi

        git -C "$MNT" diff --name-only "${PUBLISH_BASE_SHA}..${BRANCH}" > "$OUT/changed_files.txt" \
            2>/dev/null || true
        # Checked against the RANGE, not filtered at `git add`, because the agent has `git
        # commit`: an add-time pathspec exclusion only ever reaches what is still uncommitted.
        # Both exist — the exclusion above quietly drops an innocent stray edit, and this
        # refuses the publish outright when a commit carries one, which is the case that would
        # otherwise reach a runner.
        if [ "$HARVEST_OK" = 1 ] && [ -s "$OUT/changed_files.txt" ]; then
            FORBIDDEN=$(grep -E "$FORBIDDEN_PATHS_RE" "$OUT/changed_files.txt" | tr '\n' ' ' || true)
            if [ -n "$FORBIDDEN" ]; then
                harvest_failed "the range changes CI configuration, which this pipeline never publishes: $FORBIDDEN"
                HARVEST_OK=0
            fi
        fi
        if [ "$HARVEST_OK" = 1 ] && [ -s "$OUT/changed_files.txt" ] \
           && [ "$(wc -l < "$OUT/changed_files.txt")" -gt "$MAX_CHANGED_FILES" ]; then
            harvest_failed "$(wc -l < "$OUT/changed_files.txt") changed files, over the ceiling of ${MAX_CHANGED_FILES}"
            HARVEST_OK=0
        fi

        if [ "$HARVEST_OK" = 0 ]; then
            : # harvest_failed recorded the reason and removed the branch and bundle
        elif [ -s "$OUT/changed_files.txt" ]; then
            printf '%s\n' "$BRANCH" > "$OUT/branch.txt"
            # The name, not the sha: it is what the pull request targets, and the host checks it
            # against its own allow list and against the pushed range before believing it.
            [ -z "$PUBLISH_BASE" ] || printf '%s\n' "$PUBLISH_BASE" > "$OUT/publish_base.txt"
            git -C "$MNT" diff --binary "${PUBLISH_BASE_SHA}..${BRANCH}" > "$OUT/changes.patch" \
                2>/dev/null || true
            # A bundle of the RANGE, not of the branch: a full bundle would carry the project's
            # entire history (gigabytes) where the range carries only what this run added.
            # base_sha is a commit on origin, so the host already has the prerequisite — which is
            # exactly the condition `git bundle verify` checks before ffwatch fetches from it.
            if git -C "$MNT" bundle create "$OUT/work.bundle" "${PUBLISH_BASE_SHA}..${BRANCH}" \
                    >/dev/null 2>&1; then
                BUNDLE_BYTES=$(wc -c < "$OUT/work.bundle" 2>/dev/null || echo 0)
                if [ "$BUNDLE_BYTES" -gt "$MAX_BUNDLE_BYTES" ]; then
                    harvest_failed "the work bundle is ${BUNDLE_BYTES} bytes, over the ceiling of ${MAX_BUNDLE_BYTES}"
                else
                    echo "[ffbox] bundled $(wc -l < "$OUT/changed_files.txt") changed file(s)" \
                         "in $(git -C "$MNT" rev-list --count "${PUBLISH_BASE_SHA}..${BRANCH}")" \
                         "commit(s) on $BRANCH: $OUT/work.bundle"
                fi
            else
                rm -f "$OUT/work.bundle"
                echo "ffbox: WARNING: could not bundle ${PUBLISH_BASE_SHA}..${BRANCH}" >&2
            fi
        else
            # No changed files means no branch left behind and no PR (design section 17). Saying
            # nothing here would leave ffwatch unable to tell "nothing changed" from "harvest
            # broke", and those two want very different replies.
            rm -f "$OUT/work.bundle" "$OUT/branch.txt" "$OUT/changes.patch"
            echo "[ffbox] no file changes in this run — no branch, no bundle"
        fi
    else
        # No work branch: the shell lane harvests a patch instead. It has to span the agent's
        # COMMITS as well as its uncommitted edits now that it can make them — a diff of the
        # index alone would silently drop everything the agent had already committed and hand
        # back a patch that looks like a much smaller change than the one it made.
        BASE_SHA=$(cat "$OUT/base_sha.txt" 2>/dev/null || echo "")
        git -C "$MNT" add -A -- . ':(exclude).github' 2>/dev/null || true
        git -C "$MNT" diff --cached --binary ${BASE_SHA:+"$BASE_SHA"} > "$OUT/changes.patch" \
            2>/dev/null || true
        git -C "$MNT" reset >/dev/null 2>&1 || true
    fi

    if [ -s "$OUT/changes.patch" ]; then
        files=$(wc -l < "$OUT/status.txt")
        echo "[ffbox] harvested changes to $files file(s): $OUT/changes.patch"
        echo "[ffbox] apply with: git -C $DEV_CHECKOUT apply $OUT/changes.patch"
    else
        [ -n "$BRANCH" ] || echo "[ffbox] no file changes in this run"
        rm -f "$OUT/changes.patch"
    fi
    if [ -f "$OUT/base_sha.txt" ]; then
        echo "[ffbox] base sha: $(cat "$OUT/base_sha.txt")"
    fi
fi

echo "[ffbox] results: $OUT"
exit "$RUN_RC"
