[Unit]
# The rootless Docker gate. Every ffbox unit that speaks to docker orders after this one, and
# this one does not finish until the daemon answers.
#
# @WAITDOCKER@ and @DOCKERSOCK@ are substituted by 06-services.sh — this repo can be cloned
# anywhere and the socket path carries the owner's uid. Re-run
# `sudo sh ffbox/06-services.sh --install` after moving the checkout or changing the owner.
#
# WHY A UNIT AND NOT AN ExecStartPre ON EACH. Four copies of the same wait is four places to
# fix it, and a shared oneshot gives the failure one name in `systemctl status` instead of
# burying it inside whichever service happened to start first.
#
# NOT PartOf ffbox.target. A stop of the pipeline should not un-gate it, and Type=oneshot with
# RemainAfterExit means the wait is paid once per boot rather than on every dependent start.
Description=ffbox: wait for the rootless Docker daemon

# WHAT THIS ACTUALLY RACES, and it is not sysinit. The gate already orders after sysinit.target,
# so it starts only once systemd-tmpfiles-setup and the rest of early boot are done. On
# 2026-09-07 tmpfiles ran for 68 minutes, sysinit was reached at 16:21:06, and this started at
# 16:21:20 — properly after it, and still doomed: @DOCKERUSERUNIT@ did not start until 16:23:08,
# 108s later, and the wait gave up at 90.
#
# So the thing to order against is the USER MANAGER, and that IS orderable. The old comment here
# said After= cannot cross the system/user boundary; that is true of docker.service INSIDE the
# instance, and false of the instance itself — user@<uid>.service is an ordinary system unit.
#
# WANTS=, NOT JUST AFTER=. Ordering binds two jobs that are both pending; it does nothing for a
# job queued after this one already started. logind starts a lingering user manager from its own
# StartUnit call, which landed 2 minutes after boot reached basic.target — by then a bare After=
# would have had nothing to wait for. Wants= puts the instance in the same boot transaction, and
# only then does the ordering mean anything.
#
# THE POLL STAYS. user@<uid>.service going active means the manager is up, not that the docker
# unit inside it is answering, so the script still asks the daemon a question.
After=network.target @DOCKERUSERUNIT@
Wants=@DOCKERUSERUNIT@

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
User=@USER@
Group=@GROUP@
Environment=HOME=@HOME@
ExecStart=/bin/sh @WAITDOCKER@ @DOCKERSOCK@ 900
# 900, NOT 90, AND IT IS NOT THE SAME JOB AS THE ORDERING ABOVE. That closes the race against the
# user manager; this covers the part ordering cannot reach — the manager going active means the
# instance is up, not that the docker unit inside it is answering yet, and the length of that
# inner gap is a guess. On 2026-09-07 the wait needed 15 seconds more than 90 gave it, so the
# number was already wrong on its own terms before the missing ordering made it fatal. A gate
# that waits costs a slow boot some time. A gate that gives up early costs an outage nobody is
# paged for.
TimeoutStartSec=960

[Install]
WantedBy=multi-user.target
