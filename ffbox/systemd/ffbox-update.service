[Unit]
# THE UPDATER. Fetches origin, fast-forwards this checkout and restarts ffbox into the new
# code. Design: design/self_update_design.txt.
#
# @UPDATE@ is substituted with the absolute path to ffbox/update_ffbox.sh by 06-services.sh —
# this repo can be cloned anywhere, so the unit cannot carry a fixed path.
#
# DELIBERATELY NOT PART OF ffbox.target. No PartOf=, no Requires=, no BindsTo=, no After= on
# any ffbox unit, and no WantedBy=ffbox.target. A bad commit that stops ffwatch from coming up
# is exactly when an update matters, so the thing that installs the fix must not be able to go
# down with the thing it fixes. `systemctl stop ffbox.target` leaves this and its timer alone.
#
# This unit IS the trigger. The timer starts it; a human runs
# `sudo systemctl start ffbox-update.service`. One code path, so the rare one is not the
# untested one.
Description=ffbox self-update (fetch, fast-forward, restart)
Wants=network-online.target
After=network-online.target ffbox-docker.service

[Service]
Type=oneshot
# UNPRIVILEGED, as the account that owns the checkout. This used to run as root "and drop to the
# owner for every git call", which is backwards: the thing that fetches code off the internet
# every five minutes and then executes it is the last process on the box that should start with
# root and give privilege away. It now starts with none.
#
# The one thing it cannot do as itself is stop and start the services whose code it is
# replacing, so 02-zfsSetup.sh grants exactly those systemctl verbs on exactly these units in
# /etc/sudoers.d/ffbox. Installing a unit is deliberately NOT granted — writing
# /etc/systemd/system can define a unit that runs anything as anyone, which is root by another
# name — so a unit-template change is applied by a human running
# `sudo sh ffbox/06-services.sh --install`. The updater says when that is owed.
User=@USER@
Group=@GROUP@
Environment=HOME=@HOME@
Environment=FFBOX_UPDATE_REPO=@REPO@
# For its CHILDREN rather than for itself: update_ffbox.sh never calls docker, but it re-runs
# setup.sh, which runs 03-build.sh, and it does. An unset DOCKER_HOST
# there would rebuild the image on the root daemon, where nothing would ever use it.
Environment=DOCKER_HOST=unix://@DOCKERSOCK@
ExecStart=/bin/sh @UPDATE@

# THE DRAIN CAN TAKE AN HOUR. DefaultTimeoutStartSec is 90 seconds, which would kill the
# updater mid-drain on any busy machine and leave the drain flag behind (the script's EXIT trap
# lifts it, but the update would never land). 8100 = the 7200s drain ceiling plus fifteen
# minutes for the stop, merge, rebuild and restart. NOT `infinity`: a wedged updater holding
# the flock forever is worse than one that gets killed and retried on the next tick.
TimeoutStartSec=8100

[Install]
WantedBy=multi-user.target
