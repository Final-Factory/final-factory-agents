[Unit]
# The public door for game crash and multiplayer desync reports. See the header of
# ffbox/ffintake.py for the design and ffbox/README.md, "Crash and desync intake", for the
# protocol and how to put it on the internet.
#
# THIS IS THE ONLY UNIT ON THE BOX THAT A STRANGER TALKS TO, and it is shaped around that. The
# others run as the owner, read secrets.env and can reach the Docker socket; this one runs as
# `ffintake`, an account that owns nothing but the reports directory, gets NO EnvironmentFile,
# sees an empty /home, an empty /opt with two paths bound back into it (its own script,
# read-only, and the reports directory), and no devices, no capabilities and no way to gain any.
# A bug in the parser buys an attacker a process that can write reports and nothing else.
#
# @INTAKEROOT@, @INTAKEHOST@, @INTAKEPORT@ and @INTAKEARGS@ are rendered by 06-services.sh from
# the `intake` block of ~/.config/ffbox/config.json. The process does NOT read that file itself:
# it holds the Discord bot token, and this account must never be able to open it. So a change to
# the block is a `sudo sh ffbox/06-services.sh --install`, as `web_host` is.
#
# HTTPS WITH A SELF-SIGNED CERTIFICATE THE GAME PINS. 06-services.sh --install mints the pair
# into /etc/ffintake (key root-only, never overwritten) and systemd hands the process a private
# copy through LoadCredential; %d is that copy's directory. `python3 ffbox/ffintake.py --pin
# /etc/ffintake/cert.pem` prints what the game embeds.
#
# SKIPPED, NOT FAILED, until the storage exists: 02-zfsSetup.sh creates the dataset and the
# account. A box that has not run it shows this unit as inactive with a condition unmet, rather
# than as a red unit in the middle of ffbox.target.
Description=ffintake (crash and desync report intake)
PartOf=ffbox.target
After=network.target
ConditionPathIsDirectory=@INTAKEROOT@

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ffintake
Group=ffintake
LoadCredential=cert.pem:/etc/ffintake/cert.pem
LoadCredential=key.pem:/etc/ffintake/key.pem
ExecStart=/usr/bin/python3 -I -B @INTAKE@ --root @INTAKEROOT@ --host @INTAKEHOST@ --port @INTAKEPORT@ --tls-cert %d/cert.pem --tls-key %d/key.pem @INTAKEARGS@
Restart=always
RestartSec=5
# Files 0640 and directories 0750, group ffintake, so the owner (a member of that group) can read
# reports and nobody else on the box can.
UMask=0027

# --- what it can see ---------------------------------------------------------------------------
ProtectSystem=strict
ProtectHome=tmpfs
TemporaryFileSystem=/opt:ro /srv:ro /mnt:ro /media:ro
BindReadOnlyPaths=@INTAKE@
BindPaths=@INTAKEROOT@
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# --- what it can do ----------------------------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# No AF_UNIX: the Docker socket and every other local daemon are out of reach even if a file
# permission were ever wrong. The journal still gets stdout, which is an inherited descriptor.
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap @module

# --- what it can cost --------------------------------------------------------------------------
# Two bodies in memory at once (ffintake's max_bodies), each at most ~48 MB on the wire and a few
# decoded copies of that, fits well inside this. Past it the kernel kills the process and systemd
# restarts it, which costs the uploads in flight and nothing else on the box.
MemoryMax=1G
TasksMax=128
CPUQuota=100%
LimitNOFILE=1024

[Install]
WantedBy=ffbox.target
