[Unit]
# The read-only web UI over ffwatch.db (design section 19).
#
# @FFWEB@ is substituted with the absolute path to ffbox/ffweb.py by 06-services.sh — this
# repo can be cloned anywhere, so the unit cannot carry a fixed path. Re-run
# `sudo sh ffbox/06-services.sh --install` after moving the checkout.
#
# THE BIND ADDRESS COMES FROM THE CONFIG (ffwatch.web_host, default 127.0.0.1) and is rendered
# in here by 06-services.sh. The page renders transcript_event, which holds repo internals,
# file contents the agent read and raw model thinking, alongside Discord message text. It is
# behind a login (hardcoded accounts for Ben and Lothsahn; FFWEB_PASSWORD / FFWEB_USER in
# secrets.env override them) and served over TLS with a self-signed certificate minted into
# <state-dir>/tls on first
# start. That is one password against whoever can reach the port, so the default stays
# loopback: on a laptop use `ssh -N -L 8787:127.0.0.1:8787 thisbox`. On a build server people
# work against, a LAN address is a reasonable trade — but it is a trade, so make it
# deliberately. Sessions live in memory, so restarting this unit signs everyone out.
#
# It never writes: the database is opened file:...?mode=ro and ffwatch stays the sole writer.
# --enable-actions (approve/reject on the outbound queue) is deliberately NOT set here; it
# shells out to `ffwatch approve`, and a unit that carries it would mean anything that can
# reach the port can release a reply into a public thread. Add it by hand, on this box, when
# approve_before_send is on and someone is actually moderating.
#
# NOT OPTIONAL. It is part of ffbox.target and comes up with the pipeline: the outbound queue,
# the run transcripts and the verification rows are only legible through this page, and a
# moderation queue nobody can see is not a moderation queue.
Description=ffweb (read-only web UI for ffwatch)
PartOf=ffbox.target
After=network.target ffwatch.service
Wants=ffwatch.service

# A UI that cannot bind its port is a configuration problem, not a transient one; back off
# rather than respawning forever. These belong in [Unit] — systemd ignores them under
# [Service], with only a log line to say so, which is the same as having no limit at all.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@USER@
Group=@GROUP@
Environment=HOME=@HOME@
ExecStart=/usr/bin/env python3 @FFWEB@ --host @WEBHOST@ --port @WEBPORT@ --quiet
EnvironmentFile=-@HOME@/.config/ffbox/secrets.env
Restart=always
RestartSec=10

[Install]
WantedBy=ffbox.target
