#!/bin/sh
# ffgithubrunners — the operator's handle on the runners.
#
#   ffgithubrunners status              slots, containers, registrations, image tag and age
#   ffgithubrunners slots [N]           show or set the slot count
#   ffgithubrunners slot stop|start N   drain or return one slot
#   ffgithubrunners drain | resume      let running jobs finish, start no replacements
#   ffgithubrunners image update        rebuild with a current runner tarball
#   ffgithubrunners reap                run the sweep now
#   ffgithubrunners logs [N]            the last job's log for one slot
#
# WHAT NEEDS PRIVILEGE AND WHAT DOES NOT. drain, resume and slot stop|start write a flag file that
# slot.sh checks before it mints a JIT config, so a drained slot idles rather than being stopped
# and nothing has to talk to the system manager. Only `slots N` writes to /etc/systemd/system, and
# it re-invokes through sudo for that one step. No account gets a sudoers entry.

set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HERE/lib/config.sh"

say()  { printf '==> %s\n' "$*"; }
die()  { printf 'ffgithubrunners: %s\n' "$*" >&2; exit 1; }

 usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; }

# --- status ---------------------------------------------------------------------------------------

cmd_status() {
    printf 'config     %s\n' "$FFGHR_CONFIG"
    printf 'org        %s\n' "$ORG"
    printf 'labels     %s\n' "$LABELS"
    case ",$LABELS," in
        *",self-hosted,"*) ;;
        *) printf '           (no self-hosted label: main.yml does NOT route here yet)\n' ;;
    esac

    printf '\nimage      %s' "$IMAGE"
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
        _created=$(docker image inspect "$IMAGE" --format '{{.Created}}' 2>/dev/null | cut -c1-10)
        _runner=$(docker image inspect "$IMAGE" --format '{{index .Config.Labels "org.finalfactory.runner-version"}}' 2>/dev/null)
        _size=$(docker image inspect "$IMAGE" --format '{{.Size}}' 2>/dev/null | awk '{printf "%.1f GB", $1/1073741824}')
        printf '  built %s, runner %s, %s\n' "$_created" "${_runner:-unknown}" "$_size"
    else
        printf '  NOT BUILT (03-image.sh)\n'
    fi

    printf 'daemon     %s' "$DOCKER_SOCK"
    docker version >/dev/null 2>&1 && printf '  reachable\n' || printf '  UNREACHABLE\n'
    printf 'fence      %s  %s\n' "$EGRESS_NET" \
        "$(docker inspect -f '{{.State.Status}}' "$EGRESS_NAME" 2>/dev/null || echo ABSENT)"

    # Drain first and loudly. Every other line below looks like a fault when the real answer is
    # that somebody drained this on purpose and forgot.
    printf '\n'
    if [ -e "$FFGHR_DRAIN_FLAG" ]; then
        printf 'DRAINED    all slots idle: %s\n' "$(cat "$FFGHR_DRAIN_FLAG" 2>/dev/null)"
        printf '           lift with: ffgithubrunners resume\n'
    else
        printf 'drain      off\n'
    fi

    printf '\nslots      %s configured\n' "$SLOTS"
    _i=1
    while [ "$_i" -le "$SLOTS" ]; do
        _unit=$(systemctl is-active "ffgithubrunners@$_i.service" 2>/dev/null || true)
        _stop=""
        [ -e "$(ffghr_slot_stop_flag "$_i")" ] && _stop=" STOPPED"
        _c=$(docker ps --filter "name=^ffghr-.*-$_i-" --format '{{.Names}} ({{.Status}})' 2>/dev/null | head -1)
        printf '  slot %-3s unit %-10s%s %s\n' "$_i" "${_unit:-unknown}" "$_stop" "${_c:-no container}"
        _i=$((_i + 1))
    done

    printf '\nregistrations on %s\n' "$ORG"
    if . "$HERE/lib/gh.sh" 2>/dev/null && _r=$(gh_list_runners 2>/dev/null); then
        printf '%s\n' "$_r" | while IFS=' ' read -r id st nm lb; do
            [ -n "${id:-}" ] || continue
            case ",$lb," in
                *",ffgithubrunners,"*) printf '  %-6s %-8s %s\n' "$id" "$st" "$nm" ;;
                *)                     printf '  %-6s %-8s %s  (not ours)\n' "$id" "$st" "$nm" ;;
            esac
        done
    else
        printf '  could not reach GitHub (04-github.sh)\n'
    fi
}

# --- slots -----------------------------------------------------------------------------------------

cmd_slots() {
    if [ $# -eq 0 ]; then
        printf '%s\n' "$SLOTS"
        return 0
    fi
    _n=$1
    case "$_n" in ''|*[!0-9]*) die "slots takes a number, got '$_n'" ;; esac
    [ "$_n" -ge 1 ] || die "at least one slot, or use drain to stop taking work"

    KEY=slots VAL="$_n" CFG="$FFGHR_CONFIG" python3 - <<'PY'
import json, os
path = os.environ["CFG"]
with open(path) as fh:
    cfg = json.load(fh)
cfg[os.environ["KEY"]] = int(os.environ["VAL"])
tmp = path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(cfg, fh, indent=2); fh.write("\n")
os.replace(tmp, path)
PY
    say "slots = $_n in $FFGHR_CONFIG"

    # This is the ONE thing here that writes /etc/systemd/system, so it is the one thing that asks
    # for sudo. Enabling and disabling unit instances is not something a flag file can do.
    say "applying (needs root to enable or disable unit instances)"
    sudo sh "$HERE/05-services.sh" --install
}

cmd_slot() {
    _verb=${1:-}; _n=${2:-}
    case "$_verb" in stop|start) ;; *) die "usage: ffgithubrunners slot stop|start N" ;; esac
    case "$_n" in ''|*[!0-9]*) die "usage: ffgithubrunners slot stop|start N" ;; esac
    _flag=$(ffghr_slot_stop_flag "$_n")
    if [ "$_verb" = stop ]; then
        printf 'stopped by %s at %s\n' "$(id -un)" "$(date -Is)" > "$_flag"
        say "slot $_n will idle after its current job; the unit stays running"
    else
        rm -f "$_flag" && say "slot $_n will take work again (within its poll interval)"
    fi
}

cmd_drain() {
    if [ -e "$FFGHR_DRAIN_FLAG" ]; then
        say "already drained: $(cat "$FFGHR_DRAIN_FLAG" 2>/dev/null)"
        return 0
    fi
    printf 'drained by %s at %s\n' "$(id -un)" "$(date -Is)" > "$FFGHR_DRAIN_FLAG"
    say "drained. Running jobs finish; no slot takes new work."
    say "lift with: ffgithubrunners resume"
}

cmd_resume() {
    if [ -e "$FFGHR_DRAIN_FLAG" ]; then
        rm -f "$FFGHR_DRAIN_FLAG" && say "drain lifted; slots take work again within their poll interval"
    else
        say "not drained"
    fi
}

cmd_logs() {
    _n=${1:-1}
    _f="$LOG_DIR/slot-$_n.log"
    [ -r "$_f" ] || die "no log at $_f"
    printf '==> %s (%s)\n\n' "$_f" "$(du -h "$_f" 2>/dev/null | cut -f1)"
    # From the LAST job marker. The file accumulates across jobs until logrotate takes it, so a
    # plain tail shows the tail end of whatever happened to be there, which for a short job is
    # the previous job's output.
    if grep -q '^===== ffghr job ' "$_f" 2>/dev/null; then
        awk '/^===== ffghr job /{buf=""} {buf = buf $0 "\n"} END{printf "%s", buf}' "$_f"
    else
        printf '(no job marker in this file; showing the tail)\n\n'
        tail -n "${FFGHR_LOG_LINES:-200}" "$_f"
    fi
}

# --- dispatch ---------------------------------------------------------------------------------------

case "${1:-status}" in
    status)     shift 2>/dev/null || true; cmd_status ;;
    slots)      shift; cmd_slots "$@" ;;
    slot)       shift; cmd_slot "$@" ;;
    drain)      cmd_drain ;;
    resume)     cmd_resume ;;
    reap)       shift; exec sh "$HERE/reap.sh" "$@" ;;
    image)      shift
                [ "${1:-}" = update ] || die "usage: ffgithubrunners image update"
                shift; exec sh "$HERE/image-update.sh" "$@" ;;
    logs)       shift; cmd_logs "$@" ;;
    -h|--help|help) usage ;;
    *)          die "unknown command '$1'. Try: ffgithubrunners --help" ;;
esac
