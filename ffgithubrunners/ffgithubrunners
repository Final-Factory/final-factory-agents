#!/bin/sh
# ffgithubrunners — the operator's handle on the runners.
#
#   ffgithubrunners status              slots, containers, registrations, image tag and age
#   ffgithubrunners slots [N]           show or set the slot count
#   ffgithubrunners slot stop|start N   drain or return one slot
#   ffgithubrunners drain | resume      let running jobs finish, start no replacements
#   ffgithubrunners image update        rebuild with a current runner tarball
#   ffgithubrunners reap                run the sweep now
#   ffgithubrunners logs [N]            the last job's log for one slot
#   ffgithubrunners cache [list]        the workspace cache: entries, sizes, ages
#   ffgithubrunners cache seed [REF]    seed it from golden, so the first job is not cold
#   ffgithubrunners cache clear         delete every entry
#
# WHAT NEEDS PRIVILEGE AND WHAT DOES NOT. drain, resume and slot stop|start write a flag file that
# slot.sh checks before it mints a JIT config, so a drained slot idles rather than being stopped
# and nothing has to talk to the system manager. Only `slots N` writes to /etc/systemd/system, and
# it re-invokes through sudo for that one step. No account gets a sudoers entry.

set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HERE/lib/config.sh"

say()  { printf '==> %s\n' "$*"; }
die()  { printf 'ffgithubrunners: %s\n' "$*" >&2; exit 1; }

 usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; }

# --- status ---------------------------------------------------------------------------------------

cmd_status() {
    printf 'config     %s\n' "$FFGHR_CONFIG"
    printf 'org        %s\n' "$ORG"
    printf 'labels     %s\n' "$LABELS"
    case ",$LABELS," in
        *",self-hosted,"*) ;;
        *) printf '           (no self-hosted label: main.yml does NOT route here yet)\n' ;;
    esac

    printf '\nimage      %s' "$IMAGE"
    if docker image inspect "$IMAGE" >/dev/null 2>&1; then
        _created=$(docker image inspect "$IMAGE" --format '{{.Created}}' 2>/dev/null | cut -c1-10)
        _runner=$(docker image inspect "$IMAGE" --format '{{index .Config.Labels "org.finalfactory.runner-version"}}' 2>/dev/null)
        _size=$(docker image inspect "$IMAGE" --format '{{.Size}}' 2>/dev/null | awk '{printf "%.1f GB", $1/1073741824}')
        printf '  built %s, runner %s, %s\n' "$_created" "${_runner:-unknown}" "$_size"
    else
        printf '  NOT BUILT (03-image.sh)\n'
    fi

    printf 'daemon     %s' "$DOCKER_SOCK"
    docker version >/dev/null 2>&1 && printf '  reachable\n' || printf '  UNREACHABLE\n'
    printf 'fence      %s  %s\n' "$EGRESS_NET" \
        "$(docker inspect -f '{{.State.Status}}' "$EGRESS_NAME" 2>/dev/null || echo ABSENT)"

    # Drain first and loudly. Every other line below looks like a fault when the real answer is
    # that somebody drained this on purpose and forgot.
    printf '\n'
    if [ -e "$FFGHR_DRAIN_FLAG" ]; then
        printf 'DRAINED    all slots idle: %s\n' "$(cat "$FFGHR_DRAIN_FLAG" 2>/dev/null)"
        printf '           lift with: ffgithubrunners resume\n'
    else
        printf 'drain      off\n'
    fi

    printf '\nslots      %s configured\n' "$SLOTS"
    _i=1
    while [ "$_i" -le "$SLOTS" ]; do
        _unit=$(systemctl is-active "ffgithubrunners@$_i.service" 2>/dev/null || true)
        _stop=""
        [ -e "$(ffghr_slot_stop_flag "$_i")" ] && _stop=" STOPPED"
        _c=$(docker ps --filter "name=^ffghr-.*-$_i-" --format '{{.Names}} ({{.Status}})' 2>/dev/null | head -1)
        printf '  slot %-3s unit %-10s%s %s\n' "$_i" "${_unit:-unknown}" "$_stop" "${_c:-no container}"
        _i=$((_i + 1))
    done

    printf '\nworkspace cache\n'
    if [ -z "$CACHE_DIR" ]; then
        printf '  disabled (cache_dir is empty)\n'
    elif ! ffghr_cache_ready; then
        printf '  %s NOT PROVISIONED — run: sudo sh ffgithubrunners/01-hostSetup.sh\n' "$CACHE_DIR"
    else
        printf '  %s  %s used, keep %s\n' "$CACHE_DIR" \
            "$(du -sh "$FFGHR_CACHE_ENTRIES" 2>/dev/null | cut -f1)" "$CACHE_KEEP"
        _n=0
        # Newest first, which is the order the prune works in, so what is about to be evicted is
        # at the bottom where someone looking for it will find it.
        find "$FFGHR_CACHE_ENTRIES" -maxdepth 1 -type f -name '*@*.tar' -printf '%T@ %p\n' 2>/dev/null \
            | sort -rn | cut -d' ' -f2- \
            | while IFS= read -r _e; do
                  printf '    %-46s %6s  used %s\n' "$(basename -- "$_e")" \
                      "$(du -h "$_e" 2>/dev/null | cut -f1)" \
                      "$(date -d "@$(stat -c %Y "$_e.used" 2>/dev/null || stat -c %Y "$_e")" '+%Y-%m-%d %H:%M' 2>/dev/null)"
              done
        _n=$(find "$FFGHR_CACHE_ENTRIES" -maxdepth 1 -type f -name '*@*.tar' 2>/dev/null | wc -l)
        [ "$_n" -gt 0 ] || printf '    (empty — the next job on every branch will be cold)\n'
    fi

    printf '\nregistrations on %s\n' "$ORG"
    if . "$HERE/lib/gh.sh" 2>/dev/null && _r=$(gh_list_runners 2>/dev/null); then
        printf '%s\n' "$_r" | while IFS=' ' read -r id st nm lb; do
            [ -n "${id:-}" ] || continue
            case ",$lb," in
                *",ffgithubrunners,"*) printf '  %-6s %-8s %s\n' "$id" "$st" "$nm" ;;
                *)                     printf '  %-6s %-8s %s  (not ours)\n' "$id" "$st" "$nm" ;;
            esac
        done
    else
        printf '  could not reach GitHub (04-github.sh)\n'
    fi
}

# --- slots -----------------------------------------------------------------------------------------

cmd_slots() {
    if [ $# -eq 0 ]; then
        printf '%s\n' "$SLOTS"
        return 0
    fi
    _n=$1
    case "$_n" in ''|*[!0-9]*) die "slots takes a number, got '$_n'" ;; esac
    [ "$_n" -ge 1 ] || die "at least one slot, or use drain to stop taking work"

    KEY=slots VAL="$_n" CFG="$FFGHR_CONFIG" python3 - <<'PY'
import json, os
path = os.environ["CFG"]
with open(path) as fh:
    cfg = json.load(fh)
cfg[os.environ["KEY"]] = int(os.environ["VAL"])
tmp = path + ".tmp"
with open(tmp, "w") as fh:
    json.dump(cfg, fh, indent=2); fh.write("\n")
os.replace(tmp, path)
PY
    say "slots = $_n in $FFGHR_CONFIG"

    # This is the ONE thing here that writes /etc/systemd/system, so it is the one thing that asks
    # for sudo. Enabling and disabling unit instances is not something a flag file can do.
    say "applying (needs root to enable or disable unit instances)"
    sudo sh "$HERE/05-services.sh" --install
}

cmd_slot() {
    _verb=${1:-}; _n=${2:-}
    case "$_verb" in stop|start) ;; *) die "usage: ffgithubrunners slot stop|start N" ;; esac
    case "$_n" in ''|*[!0-9]*) die "usage: ffgithubrunners slot stop|start N" ;; esac
    _flag=$(ffghr_slot_stop_flag "$_n")
    if [ "$_verb" = stop ]; then
        printf 'stopped by %s at %s\n' "$(id -un)" "$(date -Is)" > "$_flag"
        say "slot $_n will idle after its current job; the unit stays running"
    else
        rm -f "$_flag" && say "slot $_n will take work again (within its poll interval)"
    fi
}

cmd_drain() {
    if [ -e "$FFGHR_DRAIN_FLAG" ]; then
        say "already drained: $(cat "$FFGHR_DRAIN_FLAG" 2>/dev/null)"
        return 0
    fi
    printf 'drained by %s at %s\n' "$(id -un)" "$(date -Is)" > "$FFGHR_DRAIN_FLAG"
    say "drained. Running jobs finish; no slot takes new work."
    say "lift with: ffgithubrunners resume"
}

cmd_resume() {
    if [ -e "$FFGHR_DRAIN_FLAG" ]; then
        rm -f "$FFGHR_DRAIN_FLAG" && say "drain lifted; slots take work again within their poll interval"
    else
        say "not drained"
    fi
}

cmd_logs() {
    _n=${1:-1}
    _f="$LOG_DIR/slot-$_n.log"
    [ -r "$_f" ] || die "no log at $_f"
    printf '==> %s (%s)\n\n' "$_f" "$(du -h "$_f" 2>/dev/null | cut -f1)"
    # From the LAST job marker. The file accumulates across jobs until logrotate takes it, so a
    # plain tail shows the tail end of whatever happened to be there, which for a short job is
    # the previous job's output.
    if grep -q '^===== ffghr job ' "$_f" 2>/dev/null; then
        awk '/^===== ffghr job /{buf=""} {buf = buf $0 "\n"} END{printf "%s", buf}' "$_f"
    else
        printf '(no job marker in this file; showing the tail)\n\n'
        tail -n "${FFGHR_LOG_LINES:-200}" "$_f"
    fi
}

# --- cache -------------------------------------------------------------------------------------------

cmd_cache() {
    [ -n "$CACHE_DIR" ] || die "the workspace cache is disabled (cache_dir is empty)"
    case "${1:-list}" in
        list)  ffghr_cache_ready || die "$CACHE_DIR is not provisioned; run 01-hostSetup.sh"
               cmd_status | sed -n '/^workspace cache$/,/^$/p' ;;

        clear) ffghr_cache_ready || die "$CACHE_DIR is not provisioned; run 01-hostSetup.sh"
               _n=$(find "$FFGHR_CACHE_ENTRIES" -maxdepth 1 -type f -name '*@*.tar' 2>/dev/null | wc -l)
               ffghr_cache_with_lock sh -c 'rm -f "$1"/*@*.tar' _ "$FFGHR_CACHE_ENTRIES" \
                   && say "deleted $_n entries" || die "could not clear $FFGHR_CACHE_ENTRIES" ;;

        # SEED IS WHAT STOPS THE FIRST JOB ON A NEW MACHINE BEING COLD, and it is also the only
        # entry that exists before CI has ever run — which is what phase D of the task list needs
        # in order to prove the golden extract. It tars ffbox's golden checkout, which is already
        # warm, already on this machine, and trusted in a way no job's archive is.
        #
        # The scope comes from the checkout's own ProjectVersion.txt rather than from a second copy
        # of the editor version kept in step by hand.
        seed)  ffghr_cache_ready || die "$CACHE_DIR is not provisioned; run 01-hostSetup.sh"
               _src=${FFGHR_GOLDEN:-/opt/FinalFactory}
               [ -d "$_src/.git" ] || die "$_src is not a git checkout (set FFGHR_GOLDEN)"
               [ -d "$_src/Library" ] || die "$_src has no Library/; there is nothing warm to seed from"
               _pv="$_src/ProjectSettings/ProjectVersion.txt"
               [ -r "$_pv" ] || die "cannot read $_pv"
               _scope=$(sed -n 's/^m_EditorVersion: *//p' "$_pv" | head -1 | tr -d '\r')
               [ -n "$_scope" ] || die "no m_EditorVersion in $_pv"
               # NOT ${2:-$(git ...)}. This script is `set -e`, git rev-parse exits 128 on a
               # checkout with no commits or a detached HEAD, and the status of a command
               # substitution IS the status of the assignment — so the plain form kills the whole
               # CLI with 128 and prints nothing. Found by seeding a fresh repo.
               _ref=${2:-}
               if [ -z "$_ref" ]; then
                   _ref=$(git -C "$_src" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
               fi
               [ -n "$_ref" ] && [ "$_ref" != HEAD ] \
                   || die "cannot work out a branch name for $_src (detached HEAD or no commits).
       Pass one: ffgithubrunners cache seed <branch>"
               _branch=$(printf '%s' "$_ref" | sed 's/[^a-zA-Z0-9._-]/-/g')
               _name="$_branch@$_scope.tar"
               ffghr_cache_name_ok "$_name" || die "'$_ref' does not sanitize to a usable entry name"

               # TAR A SNAPSHOT, NEVER THE LIVE TREE. Golden is a working checkout that ffbox,
               # an updater and a person all write to, and a five-minute tar over a live .git is a
               # race it will eventually lose: the first attempt at this died on
               #   tar: ./.git: file changed as we read it
               # because a commit landed while it read. GNU tar exits 1 on that, the archive is
               # discarded, and five minutes are gone. A ZFS snapshot is an atomic point-in-time
               # view and removes the race entirely rather than narrowing it.
               #
               # THE GOLDEN LOCK IS STILL TAKEN, but now only across the snapshot rather than the
               # whole read: a snapshot taken mid-import would capture a half-built Library, which
               # is 04-warmLibrary.sh:89-91's own stated reason for holding it. Held for a second
               # instead of five minutes.
               _glock=${FFBOX_GOLDEN_LOCK:-$FFBOX_CONFIG_DIR/golden.lock}
               _ds=$(df --output=source "$_src" 2>/dev/null | tail -1)
               _snap=""
               _readfrom="$_src"

               take_golden_lock() {
                   if [ -e "$_glock" ]; then
                       exec 8>>"$_glock" || die "cannot open $_glock"
                       say "waiting for the golden lock ($_glock)"
                       flock -s -w 3600 8 || die "could not take a shared lock on $_glock within an hour"
                   else
                       say "WARNING: $_glock does not exist; proceeding without it"
                   fi
               }
               drop_golden_lock() { exec 8>&- 2>/dev/null || true; }
               # The snapshot outlives the lock, so it has to be cleaned up on every exit path.
               drop_snapshot() {
                   [ -n "$_snap" ] || return 0
                   sudo -n zfs destroy "$_ds@$_snap" 2>/dev/null \
                       || say "WARNING: could not destroy $_ds@$_snap; remove it by hand"
                   _snap=""
               }

               case "$_ds" in
                   */*)
                       # The name has to satisfy the NOPASSWD rule in /etc/sudoers.d/ffbox, which
                       # only permits snapshots of golden named ffbox-<something>. Nothing here
                       # needs a password or a new sudoers entry.
                       _snap="ffbox-ffcache-seed-$$"
                       take_golden_lock
                       if sudo -n zfs snapshot "$_ds@$_snap" 2>/dev/null; then
                           drop_golden_lock
                           trap 'drop_snapshot' EXIT INT TERM
                           _readfrom="$_src/.zfs/snapshot/$_snap"
                           [ -d "$_readfrom" ] || die "snapshot $_ds@$_snap is not visible at $_readfrom"
                           say "reading from snapshot $_ds@$_snap"
                       else
                           _snap=""
                           say "WARNING: could not snapshot $_ds; reading the live tree instead.
       Do not commit to $_src while this runs."
                       fi ;;
                   *)  take_golden_lock
                       say "WARNING: $_src is not on a ZFS dataset; reading the live tree.
       Do not commit to $_src while this runs." ;;
               esac

               say "seeding $_name from $_readfrom (~20 GB, a few minutes)"
               _tmp="$FFGHR_CACHE_ENTRIES/.seed.$$.part"
               # Same exclusions as the save step in main.yml. Kept in step by hand, which is a
               # real cost; if they drift, the archive is merely bigger, never wrong.
               if tar -cf "$_tmp" -C "$_readfrom" \
                       --exclude=./Temp --exclude=./UserSettings \
                       --exclude='./*-artifacts' \
                       --exclude=./Library/UnityLockfile --exclude=./Library/EditorInstance.json \
                       --exclude=./.git/index.lock --exclude=./.git/hooks \
                       . ; then
                   ffghr_cache_with_lock sh -c '
                       rm -f "$1"/"$2"@*.tar
                       mv -f "$3" "$1/$4" && touch "$1/$4"
                   ' _ "$FFGHR_CACHE_ENTRIES" "$_branch" "$_tmp" "$_name" \
                       && say "seeded $_name ($(du -h "$FFGHR_CACHE_ENTRIES/$_name" 2>/dev/null | cut -f1))" \
                       || { rm -f "$_tmp"; die "could not install the seed archive"; }
               else
                   rm -f "$_tmp"
                   die "tar failed; nothing was installed"
               fi ;;

        *)     die "usage: ffgithubrunners cache [list|seed [REF]|clear]" ;;
    esac
}

# --- dispatch ---------------------------------------------------------------------------------------

case "${1:-status}" in
    status)     shift 2>/dev/null || true; cmd_status ;;
    slots)      shift; cmd_slots "$@" ;;
    slot)       shift; cmd_slot "$@" ;;
    drain)      cmd_drain ;;
    resume)     cmd_resume ;;
    reap)       shift; exec sh "$HERE/reap.sh" "$@" ;;
    image)      shift
                [ "${1:-}" = update ] || die "usage: ffgithubrunners image update"
                shift; exec sh "$HERE/image-update.sh" "$@" ;;
    logs)       shift; cmd_logs "$@" ;;
    cache)      shift; cmd_cache "$@" ;;
    -h|--help|help) usage ;;
    *)          die "unknown command '$1'. Try: ffgithubrunners --help" ;;
esac
